# header for {{NAME}} binary

# versioning script's output files to paths with $TIMESTAMP is appreciated & good
export TIMESTAMP="$(date +%y.%m.%d-%T)"
{% if item.env is not defined or item.env != False -%}
# default a DIR
[ -z "$DIR" ] && export DIR="{{DIR}}"
# source envs, using envdefault for shell-local defaults when available
[ -n "${ENV_BYPASS:-}" ] || [ ! -f "$DIR/env.export" ] || { command -v envdefault >/dev/null 2>&1 && source "$(command -v envdefault)" "$DIR/env.export" >/dev/null || source "$DIR/env.export"; }
{% endif -%}
# push current shell options onto stack for later restoration
_BIN_SETO_STATE+=("$(set +o; shopt -p)")
(( ${V:-0} > 2 )) && set -x
set -euo pipefail
shopt -s nullglob

# _cf_action runner primitives — see doc/subsys.md § Action runner.
# _cf_loud is defined at the top of files/_bin (available even for no_header scripts).

_cf_action_init() {
  local name="$1" verb="${2:-running}"
  [ "$_cf_loud" = 1 ] && printf '+ %s: %s\n' "$name" "$verb" >&2
}
_cf_action_end() {
  [ "$_cf_loud" = 1 ] && printf 'complete\n' >&2
}
_cf_report_skip() {
  local name="$1" reason="$2"
  [ "$_cf_loud" = 1 ] && printf 'skipped %s: %s\n' "$name" "$reason" >&2
}

# Core guard evaluator. Runs a command; silent (no output + exit 0) = proceed.
# Mode bitfield selects failure signals: 0x1=non-zero exit, 0x2=stderr, 0x4=stdout.
# On fail: prints reason (stdout > stderr > "exit N") to stdout, returns 1.
# On pass: silent, returns 0.
_cf_run_guard() {
  local mode="$1"; shift
  local _cf_rg_out _cf_rg_err _cf_rg_rc=0 _cf_rg_reason=""
  _cf_rg_out="$(mktemp)" ; _cf_rg_err="$(mktemp)"
  "$@" >"$_cf_rg_out" 2>"$_cf_rg_err" || _cf_rg_rc=$?
  if [ $((mode & 0x4)) -ne 0 ] && [ -s "$_cf_rg_out" ]; then
    _cf_rg_reason="$(cat "$_cf_rg_out")"
  elif [ $((mode & 0x2)) -ne 0 ] && [ -s "$_cf_rg_err" ]; then
    _cf_rg_reason="$(cat "$_cf_rg_err")"
  elif [ $((mode & 0x1)) -ne 0 ] && [ "$_cf_rg_rc" -ne 0 ]; then
    _cf_rg_reason="exit $_cf_rg_rc"
  fi
  rm -f "$_cf_rg_out" "$_cf_rg_err"
  if [ -n "$_cf_rg_reason" ]; then
    printf '%s' "$_cf_rg_reason"
    return 1
  fi
  return 0
}

# Bypass guards. Emit reason to stderr, return 1 when bypass var is set; silent otherwise.
_cf_guard_bypass() {
  local concern="$1" verb="${2:-running}"
  local var="COMPFUZOR_${concern}_BYPASS"
  if [ -n "${!var:-}" ]; then
    printf '%s: %s set, %s\n' "$(printf '%s' "$concern" | tr 'A-Z' 'a-z')" "$var" "$verb" >&2
    return 1
  fi
  return 0
}
_cf_guard_bypass_unit() {
  local concern="$1" unit="$2" verb="${3:-running}"
  local var="COMPFUZOR_${concern}_${unit}_BYPASS"
  if [ -n "${!var:-}" ]; then
    printf '%s: %s set, %s\n' "$(printf '%s' "$concern" | tr 'A-Z' 'a-z')" "$var" "$verb" >&2
    return 1
  fi
  return 0
}
