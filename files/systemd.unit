{#- `comments` in a section dict renders `# ...` lines directly above the
    [Section] header. A string value is split on newlines; a list value
    renders each entry (entries may themselves be multiline). Trailing
    whitespace is stripped per line; empty lines render as a bare `#`.
    `comments` is a template control key, never a unit directive: systemd
    directives are CamelCase and no section systemd defines ([Unit],
    [Service], [Socket], [Install], ...) has a directive named `comments`,
    so the lowercase key cannot collide with real output. A section whose
    only content is comments still renders the comments followed by the
    bare header, keeping the comment anchored to its section. -#}
{%- macro section(name, data) -%}
{#- falsy section data renders nothing (as before); truthy non-mapping
    data is an authoring error and fails loudly via .items(). -#}
{%- set data = data if data is mapping else ({} if not data else data.items()) -%}
{%- set raw_comments = data.get('comments') -%}
{%- set comment_lines = [] -%}
{%- if raw_comments -%}
{%- if raw_comments is string -%}
{%- set _ = comment_lines.extend(raw_comments.split('\n')) -%}
{%- elif raw_comments is iterable -%}
{%- for entry in raw_comments -%}
{%- set _ = comment_lines.extend((entry | string).split('\n')) -%}
{%- endfor -%}
{%- else -%}
{%- set _ = comment_lines.extend((raw_comments | string).split('\n')) -%}
{%- endif -%}
{%- endif -%}
{%- set field_keys = data.keys() | reject('eq', 'comments') | list -%}
{%- if comment_lines or field_keys -%}
{%- for line in comment_lines -%}
{{ ('# ' ~ line.rstrip()) if line.strip() else '#' }}
{% endfor -%}
[{{ name }}]
{% for key, value in data.items() -%}
{% if key == 'comments' -%}
{% elif value is sameas false -%}
{% elif value is iterable and value is not string -%}
{% for v in value -%}
{{ key }}={{ v }}
{% endfor -%}
{% elif value is string and '\n' in value -%}
{{ key }}={{ value.split('\n') | join(' \\\n\t') }}
{% else -%}
{{ key }}={{ value }}
{% endif -%}
{% endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- set _type_config = SYSTEMD_TYPE_CONFIG[UNIT_TYPE] -%}
{%- set _root = UNIT_VARS|default(vars, True) -%}
{%- for section_name in _type_config.sections -%}
{%- set _section_var = 'SYSTEMD_' ~ section_name | upper ~ 'S' -%}
{%- set _section_data = _root[_section_var] if _root[_section_var] is defined else lookup('vars', _section_var, default={}) -%}
{{ section(section_name, _section_data) }}
{%- endfor -%}
