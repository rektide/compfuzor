(defcfg
  process-unmapped-keys yes
  linux-dev-names-include ("Surface Dial Virtual Keyboard/Mouse")
  linux-output-device-name "kanata-surface-dial"
  linux-continue-if-no-devs-found yes
)

;; Suppress ONLY this emitter's synthetic Shift. Recreate the legacy
;; Shift+Volume chord in base, preserving media-keys' 0.01 fallback.
(defsrc lsft volu vold)
(deflayer base XX S-volu S-vold)
(deflayer precision XX f23 f24)
(defvirtualkeys precision-hold (layer-while-held precision))
