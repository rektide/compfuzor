# Durable policy fragment; the full normalized config is config-debian-plus.
# Toolchain identity is derived by Kconfig from the make invocation, not set
# here. Generate with LLVM=1 for Clang/LLD. To fall back to GCC/BFD, omit
# LLVM=1 from both olddefconfig and every subsequent make invocation.

# Host-specific policy retained from the current custom kernel.
CONFIG_X86_NATIVE_CPU=y
CONFIG_X86_INTEL_TSX_MODE_OFF=y
# CONFIG_X86_INTEL_TSX_MODE_AUTO is not set

# Shared compiler policy: use the kernel's conventional -O2 performance mode.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
# CONFIG_BTRFS_EXPERIMENTAL is not set
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y

CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"

# Preserve the current low-hardening policy rather than inheriting Debian's.
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_KSTACK_OFFSET is not set
# CONFIG_SLAB_FREELIST_HARDENED is not set
# CONFIG_SLAB_BUCKETS is not set
CONFIG_PROC_MEM_ALWAYS_FORCE=y
# CONFIG_PROC_MEM_FORCE_PTRACE is not set

CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_HIBERNATION_COMP_LZ4=y
# CONFIG_HIBERNATION_COMP_LZO is not set
CONFIG_HIBERNATION_DEF_COMP="lz4"
CONFIG_CRYPTO_LZ4=y

# Persistent crash evidence. Keep the backend available from early boot and
# compile every pstore frontend so the ramoops allocation is actually usable.
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=1
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_RAM=y

# Useful visual and deliberate crash-test facilities.
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="qr_code"
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
CONFIG_LKDTM=m

# Rust support. 7.3 moved the panic-QR generator (DRM_PANIC_SCREEN_QR_CODE)
# behind RUST, and availability rides on the host toolchain probe (rustc,
# rust-src, bindgen). Restating the value here keeps the policy durable
# across renormalizations. The fragment is a reassertion, not a guard:
# merge_config.sh -m stops before Kconfig verification, so a probe failure
# silently drops this at the olddefconfig step. Catch it through the
# explicit required-option audit of the normalized config, not through
# merge warnings.
CONFIG_RUST=y
