# Audit expectations, NOT an automatically applied policy fragment.
# These are the parent's required Rust, panic-QR and debugging choices.
# Inherited matches do not establish that our durable policy declares them.
CONFIG_RUST=y
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="qr_code"
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
CONFIG_DRM_PANIC_SCREEN_QR_CODE_URL="https://deb.li/panic#"
CONFIG_DRM_PANIC_SCREEN_QR_VERSION=40
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
