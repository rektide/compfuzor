{% set nl = joiner('\n') -%}
{{ nl() }}# generated from PKGS/PKGSET/PKGSETS for debootstrap --include
{% set direct_pkgs = PKGS|normalize(to='list') -%}
{% if direct_pkgs|length > 0 -%}
{{ nl() }}# PKGS: {{ direct_pkgs|join(',') }}
{{ nl() }}{{ direct_pkgs|join(',') }}
{% endif -%}
{% set pkgsets = PKGSET|normalize(to='list') + PKGSETS|normalize(to='list') -%}
{% for pkgset in pkgsets -%}
{% set row = lookup('vars', pkgset, default=[])|normalize(to='list') -%}
{{ nl() }}# PKGSET {{ pkgset }}: {{ row|join(',') }}
{{ nl() }}{{ row|join(',') }}
{% endfor -%}
