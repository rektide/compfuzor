#!/usr/bin/env zsh
# `opencode-last list` prints executable dated snapshots newest-first;
# otherwise run the newest snapshot with the managed client environment.

emulate -L zsh
setopt extended_glob

typeset snapshot_dir=${OPENCODE_SNAPSHOT_DIR:-/usr/local/bin}
typeset candidate stamp
typeset -A snapshot_by_stamp
typeset -a stamps

for candidate in "$snapshot_dir"/opencode-[0-9]##(N); do
  [[ -x $candidate ]] || continue
  stamp=${candidate:t}
  stamp=${stamp#opencode-}
  case ${#stamp} in
    8) stamp+="000000" ;;
    12) stamp+="00" ;;
    14) ;;
    *) continue ;;
  esac
  snapshot_by_stamp[$stamp]=$candidate
done

stamps=("${(@Ok)snapshot_by_stamp}")

if [[ ${argv[1]:-} == list ]]; then
  (( $# == 1 )) || {
    print -u2 "usage: opencode-last list"
    exit 2
  }
  for stamp in "${stamps[@]}"; do
    print -r -- "${snapshot_by_stamp[$stamp]}"
  done
  exit 0
fi

if (( ${#stamps} == 0 )); then
  print -u2 "opencode-last: no executable dated clients in $snapshot_dir"
  exit 127
fi

export OPENCODE_BINARY=${snapshot_by_stamp[$stamps[1]]}
export OPENCODE_SERVER_PORT=${OPENCODE_SERVER_PORT:-49373}
export OPENCODE_SERVER_URL=${OPENCODE_SERVER_URL:-http://127.0.0.1:$OPENCODE_SERVER_PORT}
export OPENCODE_PASSWORD_FILE=${OPENCODE_PASSWORD_FILE:-$HOME/.config/opencode/secrets/OPENCODE_PASSWORD}
unset OPENCODE_PASSWORD

typeset client_env_module=${OPENCODE_CLIENT_ENV_MODULE:-/etc/opt/opencode-git/zim-modules/opencode-client-args/init.zsh}
if [[ ! -r $client_env_module ]]; then
  print -u2 "opencode-last: cannot read the client environment module: $client_env_module"
  exit 1
fi

source "$client_env_module"

if [[ ! -x $OPENCODE_BINARY ]]; then
  print -u2 "opencode-last: client binary is not executable: $OPENCODE_BINARY"
  exit 127
fi
if [[ -z ${OPENCODE_PASSWORD:-} ]]; then
  print -u2 "opencode-last: OPENCODE_PASSWORD was not loaded from $OPENCODE_PASSWORD_FILE"
  exit 1
fi
exec "$OPENCODE_BINARY" "$@"
