#!/usr/bin/env zsh
# opencode-<INSTANCE> — explicit-server client entrypoint for one secondary
# OpenCode deployment. Linked globally under the instance's own name (for the
# primary `git` instance this launcher is not installed; interactive shells
# there get native OPENCODE_ARGS from the opencode ZIM module instead).
#
# The launcher is deliberately instance-neutral: deployment facts come from
# its rendered env file. It loads the same client environment ZIM module as the
# primary shell (with this instance's server URL and credential), then execs
# the configured client binary. OpenCode itself interprets OPENCODE_ARGS.
# The launcher never manages the server lifecycle; its systemd user unit does.

emulate -L zsh

# Resolve the deployment root through the global symlink: /usr/local/bin/
# opencode-<INSTANCE> -> <DIR>/bin/opencode-instance, so ${0:A:h:h} is <DIR>.
typeset _oc_dir="${0:A:h:h}"
if [[ ! -r ${_oc_dir}/env ]]; then
  print -u2 "opencode: cannot read the instance env: ${_oc_dir}/env"
  exit 1
fi
# allexport while sourcing env so the client child process inherits the
# instance contract (config dir, database, server URL, credential file).
# The env file never contains the secret itself.
setopt allexport
source "${_oc_dir}/env"
unsetopt allexport
unset _oc_dir

if [[ -z ${OPENCODE_CLIENT_ENV_MODULE:-} ]]; then
  print -u2 "opencode: OPENCODE_CLIENT_ENV_MODULE is not set in the instance env"
  exit 1
fi
if [[ ! -r ${OPENCODE_CLIENT_ENV_MODULE} ]]; then
  print -u2 "opencode: cannot read the client environment module: ${OPENCODE_CLIENT_ENV_MODULE}"
  exit 1
fi

# Drop an inherited non-empty primary default so the instance module supplies
# this instance's URL. Preserve an explicit empty override for --standalone.
if [[ -n ${OPENCODE_ARGS:-} ]]; then
  unset OPENCODE_ARGS
fi

source "${OPENCODE_CLIENT_ENV_MODULE}"

if [[ ! -x ${OPENCODE_BINARY:-} ]]; then
  print -u2 "opencode: instance client is not executable: ${OPENCODE_BINARY:-<unset>}"
  exit 127
fi
if [[ -z ${OPENCODE_PASSWORD:-} ]]; then
  print -u2 "opencode: OPENCODE_PASSWORD was not loaded from ${OPENCODE_PASSWORD_FILE:-the configured password file}"
  exit 1
fi
exec "$OPENCODE_BINARY" "$@"
