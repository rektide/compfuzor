{{ item.late|join2("\n") }}
_cf_action_end
_cf_body_completed=1
fi
{% endif %}
{% if _cf_run_all|length > 0 %}
{% for run_bin in _cf_run_all %}
if [ "$_cf_loud" = 1 ]; then printf '+ %s\n' '{{ run_bin }}'; fi
"$DIR/bin/{{ run_bin }}" "$@"
{% endfor %}
{% if _body_local_bypass %}
if [ "$_cf_body_completed" = 0 ] && [ "$_cf_loud" = 1 ]; then printf 'complete\n'; fi
{% else %}
if [ "$_cf_loud" = 1 ]; then printf 'complete\n'; fi
{% endif %}
{% endif %}
{% if not _body_local_bypass %}
