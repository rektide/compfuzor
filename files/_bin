#!/bin/bash
{% set _item_helpers = item.helpers | default(none) %}
{% set _nuclear = _item_helpers is sameas false %}
{% set _helper_layers = [
  DEFAULT_HELPERS | default(['env', 'setopts', 'loud']),
  item.base_helpers | default(none),
  ['report', 'guard'] if item.bypass is defined and item.bypass is not sameas false else none,
  _item_helpers,
] %}
{% set _helpers = [] if _nuclear else _helper_layers | resolve_helpers %}
{% for _h in _helpers %}
{{ _h | helper_comment }}
{% include "_helpers/" ~ _h %}

{% endfor %}
{% if not _nuclear %}

{% if item.comments is defined %}#{{item.comments}}{% endif %}

{% for var in item.vars|default([]) %}
export {{var}}="{{ '${' }}{{ var }}-{{ lookup('vars', var) }}{{ '}'}}"
{% endfor %}
{% if 'env' in _helpers %}
{% if item.basedir|default(True) == True %}
cd "${DIR}"
{% elif item.basedir|default(True) == False %}
{% elif item.basedir[0] == "/" or item.basedir[0] == "~" %}
cd {{item.basedir}}
{% else %}
cd {{DIR}}/{{item.basedir}}
{% endif %}
{% endif %}

{% endif %}
{% if item.bypass is defined and item.bypass is not sameas false and not _nuclear %}
{% set _cf_bypass = item.bypass if item.bypass is iterable and item.bypass is not string else [item.bypass] %}
_cf_action_init "{{ item.name }}" "running"
{% for _cf_entry in _cf_bypass %}
{% if ':' in _cf_entry %}
{% set _cf_parts = _cf_entry.split(':') %}
if ! reason="$(_cf_run_guard 3 _cf_guard_bypass_unit "{{ _cf_parts[0] }}" "{{ _cf_parts[1] }}" "running")"; then _cf_report_skip "{{ item.name }}" "$reason"; _cf_action_end; exit 0; fi
{% else %}
if ! reason="$(_cf_run_guard 3 _cf_guard_bypass "{{ _cf_entry }}" "running")"; then _cf_report_skip "{{ item.name }}" "$reason"; _cf_action_end; exit 0; fi
{% endif %}
{% endfor %}
{% endif %}
{{ item.early|join2("\n") }}
{{ item.generated|join2("\n") if item.generatedAt|def == "early" else omit }}
{{ item.content|join2("\n") }}
{{ item.exec|join2("\n") }}
{{ item.execs|join2("\n") }}
{{ item.generated|join2("\n") if item.generatedAt|def("end") == "end" else omit }}
{% set _cf_run_all = item.run_all|normalize(to='list') %}
{% if _cf_run_all|length > 0 %}
{% for run_bin in _cf_run_all %}
if [ "$_cf_loud" = 1 ]; then printf '+ %s\n' '{{ run_bin }}'; fi
"$DIR/bin/{{ run_bin }}" "$@"
{% endfor %}
if [ "$_cf_loud" = 1 ]; then printf 'complete\n'; fi
{% endif %}
{{ item.late|join2("\n") }}
{% if item.bypass is defined and not _nuclear %}
_cf_action_end
{% endif %}
{% for _h in _helpers | reverse %}
{% set _epi = "_helpers/" ~ _h ~ ".footer" %}
{% include _epi ignore missing %}
{% endfor %}
