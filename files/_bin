#!/bin/bash
{% set _item_helpers = item.helpers | default(none) %}
{% set _nuclear = _item_helpers is sameas false %}
{% set _cf_run_all = item.run_all|normalize(to='list') %}
{% set _is_compositor = item.generated_by | default('') == 'gen_bins' and _cf_run_all | length > 0 %}
{% set _has_own_body = item.early is defined or item.generated is defined or item.content is defined or item.exec is defined or item.execs is defined or item.late is defined %}
{% set _fallback_type = TYPE | default(none) if not _is_compositor or _has_own_body else none %}
{% set _resolver_bypass = false if _is_compositor and not _has_own_body else item.bypass | default(none) %}
{% set _disarm = item.name | resolve_bin_disarm(
  item.origin_subsystems | default(none),
  item.bypass_scopes | default(none),
  _resolver_bypass,
  _fallback_type,
) %}
{% set _active_bypass = _disarm.entries | length > 0 and not _nuclear %}
{% set _body_local_bypass = _active_bypass and _is_compositor and _has_own_body %}
{% set _cf_verb = item.verb | default(_disarm.verb) %}
{% set _helper_layers = [
  DEFAULT_HELPERS | default(['env', 'setopts', 'loud']),
  item.base_helpers | default(none),
  ['report', 'guard'] if _active_bypass else none,
  _item_helpers,
] %}
{% set _helpers = [] if _nuclear else _helper_layers | resolve_helpers %}
