{% elif item.basedir[0] == "/" or item.basedir[0] == "~" %}
cd {{item.basedir}}
{% else %}
cd {{DIR}}/{{item.basedir}}
{% endif %}
{% endif %}

{% endif %}
{% if _active_bypass %}
_cf_action_init "{{ _disarm.name }}" "{{ _cf_verb }}" "{{ _disarm.report_labels }}"
{% if _body_local_bypass %}
_cf_body_run=1
_cf_body_completed=0
{% endif %}
{% for _cf_entry in _disarm.entries %}
{% if ':' in _cf_entry %}
{% set _cf_parts = _cf_entry.split(':', 1) %}
{% if _body_local_bypass %}
if [ "$_cf_body_run" = 1 ] && ! reason="$(_cf_run_guard 3 _cf_guard_bypass_unit "{{ _cf_parts[0] }}" "{{ _cf_parts[1] }}" "{{ _cf_verb }}")"; then _cf_report_skip "{{ _disarm.name }}" "$reason" "{{ _disarm.report_labels }}"; _cf_body_run=0; fi
{% else %}
if ! reason="$(_cf_run_guard 3 _cf_guard_bypass_unit "{{ _cf_parts[0] }}" "{{ _cf_parts[1] }}" "{{ _cf_verb }}")"; then _cf_report_skip "{{ _disarm.name }}" "$reason" "{{ _disarm.report_labels }}"; exit 0; fi
{% endif %}
{% else %}
{% if _body_local_bypass %}
if [ "$_cf_body_run" = 1 ] && ! reason="$(_cf_run_guard 3 _cf_guard_bypass "{{ _cf_entry }}" "{{ _cf_verb }}")"; then _cf_report_skip "{{ _disarm.name }}" "$reason" "{{ _disarm.report_labels }}"; _cf_body_run=0; fi
{% else %}
if ! reason="$(_cf_run_guard 3 _cf_guard_bypass "{{ _cf_entry }}" "{{ _cf_verb }}")"; then _cf_report_skip "{{ _disarm.name }}" "$reason" "{{ _disarm.report_labels }}"; exit 0; fi
{% endif %}
{% endif %}
