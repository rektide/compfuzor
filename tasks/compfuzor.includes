---
- debug: "msg='Compfuzor: starting VARIABLES'"
- import_tasks: compfuzor/vars_base.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_type.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_user.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_env.tasks
  tags: ['vars', 'always']
- debug: "msg='Compfuzor: sourcing hierarchy vars'"
- import_tasks: compfuzor/vars_fs.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/_multi.tasks
  vars:
    multi: vars_hierarchy
    keys: False
  tags: ['vars', 'always']
- debug: "msg='Compfuzor: sourcing extra variables'"
- import_tasks: compfuzor/gen_passwords.tasks
  when: PASSWORDS is defined
  tags: ['password', 'vars', 'always']
- import_tasks: compfuzor/vars_apt.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_systemd.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_systemd_env.tasks
  when: SYSTEMD_ENV is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_systemd_unit.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_src.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/sub_get_urls.tasks
  when: GET_URLS is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_get_urls.tasks
  when: lookup('subsys', id='get_urls', get='active', default=false) | bool
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_cmake.tasks
  when: CMAKE is deftruthy or CMAKE_ARGS is defined or CMAKE_BUILDS is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_make.tasks
  when: MAKE is deftruthy or MAKE_AUTOCONF is deftruthy
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_debconf.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_pg.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_repo.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_npm.tasks
  when: NPM is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_rust.tasks
  when: RUST is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_mcp.tasks
  when: MCP_COMMAND is defined or MCP_URL is defined or MCP_CLIENT is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/sub_config.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_config.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_zim.tasks
  when: ZIM_MODULE is defined or ZIM_MODULES is defined or ZIM_HOST is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_nodejs.tasks
  when: NODEJS is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_bun.tasks
  when: BUN is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_python.tasks
  when: PYTHON is deftruthy or PIP is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_go.tasks
  when: GO is deftruthy
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_bazel.tasks
  when: BAZEL is deftruthy
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_tool_versions.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_readme.tasks
  when: README is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/vars_nvim.tasks
  when: NVIM is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_kernel.tasks
  when: KERNEL_MODULES is defined or KERNEL_MODPROBE is defined or KERNEL_SYSCTL is defined or KERNEL_SYSFS is defined or KERNEL_PARAMS is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_status.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_bins.tasks
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_desktop.tasks
  when: DESKTOP is defined
  tags: ['vars', 'always']
- import_tasks: compfuzor/gen_patches.tasks
  when: PR_PATCHES is defined
  tags: ['vars', 'always']
- debug: "msg='Compfuzor: completed vars'"

- import_tasks: compfuzor/user.tasks

- debug: "msg=''"
- debug: "msg='Compfuzor: REPOSITORIES'"
- import_tasks: compfuzor/repo_go.tasks
  when: REPO_GO is deftruthy and REPO_BYPASS is deffalsy
- import_tasks: compfuzor/repo_git.tasks
  when: (REPO is defined or REPOS is defined or REPO_WORKTREE is defined) and GIT_BYPASS is deffalsy and REPO_BYPASS is deffalsy
- import_tasks: compfuzor/repo_cvs.tasks
  when: CVS_REPO is defined and REPO_BYPASS is deffalsy
- import_tasks: compfuzor/repo_svn.tasks
  when: SVN_REPO is defined and REPO_BYPASS is deffalsy
- import_tasks: compfuzor/repo_hg.tasks
  when: HG_REPO is defined and HG_RAW is deffalsy and REPO_BYPASS is deffalsy
- import_tasks: compfuzor/repo_hg_raw.tasks
  when: HG_REPO is defined and HG_RAW is deftruthy and REPO_BYPASS is deffalsy

- debug: "msg=''"
- debug: "msg='Compfuzor: FILESYSTEM'"
- import_tasks: compfuzor/fs_base.tasks
  when: >
    (DIR is deftruthy or DIRS is deftruthy or FILES is deftruthy) and
    DIR_BYPASS is deffalsy and FS_BYPASS is deffalsy
- import_tasks: compfuzor/fs_repo.tasks
- import_tasks: compfuzor/fs_env.tasks
  when: >
    not ENV_BYPASS|default(False)|bool and
    (
      has_env.stdout|default(0)|int != 0 or
      has_env_export.stdout|default(0)|int != 0 or
      has_env_usermode.stdout|default(0)|int != 0 or
      (ENV is defined and (ENV is mapping or (ENV is boolean and ENV))) or
      (ENV_PRIO is defined and (ENV_PRIO is mapping or (ENV_PRIO is boolean and ENV_PRIO))) or
      ENV_LIST|normalize(to='list')|length > 0 or
      ENV_PRIO_LIST|normalize(to='list')|length > 0
    )
- import_tasks: compfuzor/_multi.tasks
  vars:
    multi: fs_hierarchy
    keys:
      - "DIRS"
      - "DIR"
      - "FILES"
  when: FS_BYPASS is deffalsy and DIR_BYPASS is deffalsy
- import_tasks: compfuzor/fs_srcs_too.tasks
  when: type == "src" and FS_SRCS_BYPASS is deffalsy
- import_tasks: compfuzor/fs_tgz.tasks
  when: TGZ is defined and TGZ_BYPASS is deffalsy
- import_tasks: compfuzor/fs_zip.tasks
  when: ZIP is defined and ZIP_BYPASS is deffalsy
- import_tasks: compfuzor/fs_get_urls.tasks
  when: lookup('subsys', id='get_urls', get='active', default=false) | bool
- import_tasks: compfuzor/bins.tasks
  when: (BINS is deflengthy or BINS_ABSENT is deflengthy) and BINS_BYPASS is deffalsy
- import_tasks: compfuzor/bins_link.tasks
  when: BINS is deflengthy and BINS_BYPASS is deffalsy
- import_tasks: compfuzor/bins_link_global.tasks
  when: BINS is defined and BINS_BYPASS is deffalsy and GLOBAL_BINS_BYPASS is deffalsy
- import_tasks: compfuzor/links.tasks
  when: LINKS is deftruthy and LINKS_BYPASS is deffalsy
- debug: "msg='Compfuzor: completed filesystem'"

- debug: "msg=''"
- debug: "msg='Compfuzor: EXTRAS'"
- import_tasks: compfuzor/pg.tasks
  when: PG is deftruthy
- import_tasks: compfuzor/debconf.tasks
  when: DEBCONF_BYPASS is deffalsy
- import_tasks: compfuzor/apt.tasks
  when: (APT_REPO|default(APT_REPOS) is deftruthy or APT_LIST_URL is deftruthy) and APT_BYPASS is deffalsy
- import_tasks: compfuzor/pkgs.tasks
  when: (PKGS is defined or PKGSET is defined or PKGSETS is defined) and PKGS_BYPASS is deffalsy and USERMODE is deffalsy
- import_tasks: compfuzor/dbconfig.tasks
  when: DBCONFIG is deftruthy and DBCONFIG_BYPASS is deffalsy
- import_tasks: compfuzor/kernel_modules.tasks
  when: MODULES is deftruthy
- import_tasks: compfuzor/bins_run.tasks
  when: BINS_BYPASS is deffalsy and BINS_RUN_BYPASS is deffalsy
- import_tasks: compfuzor/pkgconfig.tasks
  when: PKGCONFIG is deftruthy
- import_tasks: compfuzor/sysctl.tasks
  when: SYSCTLS is deftruthy or SYSCTL is deftruthy
- import_tasks: compfuzor/go.tasks
  when: REPO_GO is deftruthy

- import_tasks: compfuzor/bins_link.tasks
  vars:
    delay_phase: postRun
- import_tasks: compfuzor/bins_link_global.tasks
  vars:
    delay_phase: postRun
  when: BINS is defined and BINS_BYPASS is deffalsy and GLOBAL_BINS_BYPASS is deffalsy
# System scope systemd units
#- import_tasks: compfuzor/systemd.tasks
#  vars:
#    become: True
#  when: SYSTEMD_BYPASS|default(False) is falsy
## User scope systemd units (dual generation)
#- import_tasks: compfuzor/systemd.tasks
#  vars:
#    become: false
#    SYSTEMD_SCOPE: user
#  when: >
#    SYSTEMD_BYPASS|default(False) is falsy and
#    SYSTEMD_DUAL|default(True)
- include_tasks: systemd.thunk.tasks
  vars:
    service: "{{SYSTEMD_SERVICE}}{{ '@' + item if item != '' else '' }}"
  when: SYSTEMD_BYPASS is deffalsy and SYSTEMD_THUNK_BYPASS is deffalsy and SYSTEMD_SERVICE is deftruthy and SYSTEMD_EXEC is defined
  with_items: "{{SYSTEMD_INSTANCES|default([''])}}"

- debug: "msg='Compfuzor: `{{NAME}}` complete. Returning to main playbook.'"
