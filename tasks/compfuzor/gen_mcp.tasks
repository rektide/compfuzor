---
# gen_mcp.tasks — MCP server configuration and client tooling.
#
# MCP clients declare CONFIGS; the central config synthesis pass provides
# their merger, generic toggles, status, and apply ordering.
#
# What MCP contributes itself:
#   - mcp.json ETC_FILES (server config, from MCP_URL or MCP_COMMAND)
#   - mcp-dropin.ts (thin transform delegated to a named remote lifecycle tool)

- name: 'Build vars for remote MCP server'
  set_fact:
    ETC_FILES: "{{ [mcp_file] | merge_list(ETC_FILES, preset='append') }}"
  vars:
    mcp_file:
      name: mcp.json
      json:
        type: remote
        url: "{{ MCP_URL }}"
        headers: "{{ MCP_HEADERS|default(omit) }}"
  when: MCP_URL is defined

- name: 'Build vars for local MCP server'
  set_fact:
    ETC_FILES: "{{ [mcp_file] | merge_list(ETC_FILES, preset='append') }}"
  vars:
    mcp_command_with_args: >-
      {%- set args = [] -%}
      {%- for key in (ENV|default({})).keys() -%}
        {%- if key.startswith('mcp_arg_') and ENV[key] | string | length > 0 -%}
          {%- set _ = args.append('--' + key.replace('mcp_arg_', '').replace('_', '-') + '=${' + key.upper() + '}') -%}
        {%- endif -%}
      {%- endfor -%}
      {{- MCP_COMMAND + args }}
    mcp_file:
      name: mcp.json
      json:
        type: local
        command: "{{ mcp_command_with_args }}"
        environment: >-
          {%- if MCP_ENV is defined -%}
          {%- if MCP_ENV is mapping -%}
          {{ MCP_ENV }}
          {%- elif MCP_ENV is sequence -%}
          {%- set env_dict = {} -%}
          {%- for var in MCP_ENV -%}
          {%- set _ = env_dict.update({var: '${' + var + '}'}) -%}
          {%- endfor -%}
          {{ env_dict }}
          {%- endif -%}
          {%- else -%}
          {{ omit }}
          {%- endif -%}
  when: MCP_COMMAND is defined

- name: 'Validate MCP drop-in helper request'
  assert:
    that:
      - MCP_CLIENT is mapping
      - MCP_CLIENT.remote is string
      - MCP_CLIENT.wrapper is string
    fail_msg: 'MCP_CLIENT requires string remote and wrapper fields'
  when: MCP_CLIENT is defined

- name: 'Contribute MCP drop-in helper'
  set_fact:
    BINS: "{{ BINS | merge_list([helper, implementation] | annotate_bins('mcp'), preset='bins_generated') }}"
  vars:
    helper:
      name: mcp-dropin.ts
      basedir: False
      content: >-
        exec "$DIR/bin/mcp-dropin-core.ts"
        {{ MCP_CLIENT.remote | quote }}
        {{ MCP_CLIENT.wrapper | quote }}
        {{ (MCP_CLIENT.command_args | default(false) | bool) | ternary('true', 'false') }}
        "$@"
    implementation:
      name: mcp-dropin-core.ts
      src: ../mcp-dropin.ts
      basedir: False
  when: MCP_CLIENT is defined
