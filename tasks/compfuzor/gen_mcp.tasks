---
# gen_mcp.tasks — portable MCP server records.
#
# Clients declare CONFIGS for importing records. MCP_COMMAND/MCP_URL only
# contribute producer data; the generic config-remote command links it.

- name: 'Build vars for remote MCP server'
  set_fact:
    ETC_FILES: "{{ [mcp_file] | merge_list(ETC_FILES, preset='append') }}"
  vars:
    mcp_file:
      name: mcp.json
      json: "{{ {'type': 'remote', 'url': MCP_URL} | combine({'headers': MCP_HEADERS} if MCP_HEADERS is defined else {}) }}"
  when: MCP_URL is defined

- name: 'Compute local MCP invocation'
  set_fact:
    _mcp_command_with_args: >-
      {%- set args = [] -%}
      {%- for key in (ENV|default({})).keys() -%}
        {%- if key.startswith('mcp_arg_') and ENV[key] | string | length > 0 -%}
          {%- set _ = args.append('--' + key.replace('mcp_arg_', '').replace('_', '-') + '=${' + key.upper() + '}') -%}
        {%- endif -%}
      {%- endfor -%}
      {{- MCP_COMMAND + args }}
  when: MCP_COMMAND is defined

- name: 'Compute local MCP environment'
  set_fact:
    _mcp_environment: >-
      {%- if MCP_ENV is mapping -%}
      {{ MCP_ENV }}
      {%- else -%}
      {%- set env_dict = {} -%}
      {%- for var in MCP_ENV -%}
      {%- set _ = env_dict.update({var: '${' + var + '}'}) -%}
      {%- endfor -%}
      {{ env_dict }}
      {%- endif -%}
  when: MCP_COMMAND is defined and MCP_ENV is defined

- name: 'Build vars for local MCP server'
  set_fact:
    ETC_FILES: "{{ [mcp_file] | merge_list(ETC_FILES, preset='append') }}"
  vars:
    mcp_file:
      name: mcp.json
      json: "{{ {'type': 'local', 'command': _mcp_command_with_args} | combine({'environment': _mcp_environment} if MCP_ENV is defined else {}) }}"
  when: MCP_COMMAND is defined
