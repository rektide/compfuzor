---
# gen_mcp.tasks — MCP server configuration and client tooling.
#
# MCP clients declare DROPINS/CONFIGS; the central config synthesis pass provides
# their merger, generic toggles, status, and apply ordering.
#
# What MCP contributes itself:
#   - mcp.json ETC_FILES (server config, from MCP_URL or MCP_COMMAND)
#   - mcp-install.ts (MCP server installer)

- name: 'Build vars for remote MCP server'
  set_fact:
    ETC_FILES: "{{ [mcp_file] | merge_list(ETC_FILES, preset='append') }}"
  vars:
    mcp_file:
      name: mcp.json
      json:
        type: remote
        url: "{{ MCP_URL }}"
        headers: "{{ MCP_HEADERS|default(omit) }}"
  when: MCP_URL is defined

- name: 'Build vars for local MCP server'
  set_fact:
    ETC_FILES: "{{ [mcp_file] | merge_list(ETC_FILES, preset='append') }}"
  vars:
    mcp_command_with_args: >-
      {%- set args = [] -%}
      {%- for key in (ENV|default({})).keys() -%}
        {%- if key.startswith('mcp_arg_') and ENV[key] | string | length > 0 -%}
          {%- set _ = args.append('--' + key.replace('mcp_arg_', '').replace('_', '-') + '=${' + key.upper() + '}') -%}
        {%- endif -%}
      {%- endfor -%}
      {{- MCP_COMMAND + args }}
    mcp_file:
      name: mcp.json
      json:
        type: local
        command: "{{ mcp_command_with_args }}"
        environment: >-
          {%- if MCP_ENV is defined -%}
          {%- if MCP_ENV is mapping -%}
          {{ MCP_ENV }}
          {%- elif MCP_ENV is sequence -%}
          {%- set env_dict = {} -%}
          {%- for var in MCP_ENV -%}
          {%- set _ = env_dict.update({var: '${' + var + '}'}) -%}
          {%- endfor -%}
          {{ env_dict }}
          {%- endif -%}
          {%- else -%}
          {{ omit }}
          {%- endif -%}
  when: MCP_COMMAND is defined

- name: 'Contribute MCP installer'
  set_fact:
    BINS: "{{ BINS | merge_list([install] | annotate_bins('mcp'), preset='bins_generated') }}"
  vars:
    install:
      name: mcp-install.ts
      src: ../mcp-install.ts
      basedir: False
  when: MCP_CLIENT is defined
