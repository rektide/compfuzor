# packages which are opt but from source (and which retain source in original form) should probably set this, showing themselves a presence in SRCS_DIR.
- stat: path="{{OPT}}"
  register: has_opt
- name: "link source DIR into OPT"
  file:
    src: "{{OPT_SRCS_DIR|default(DIR)}}"
    dest: "{{OPT}}"
    state: link
    owner: "{{OWNER|def(omit)}}"
    group: "{{GROUP|def(omit)}}"
  become: "{{ _become.become }}"
  when: DIR != OPT and OPT_DIR is deffalsy
  vars:
    _become: "{{ OPT|become_calc }}"
- name: "insure OPT dir"
  file:
    path: "{{OPT}}"
    state: directory
    owner: "{{OWNER|def(omit)}}"
    group: "{{GROUP|def(omit)}}"
  become: "{{ _become.become }}"
  when: DIR != OPT and OPT_DIR is deftruthy
  vars:
    _become: "{{ OPT|become_calc }}"
- name: "link source DIR into OPT/src"
  file:
    src: "{{DIR}}"
    dest: "{{_dest}}"
    state: link
    owner: "{{OWNER|def(omit)}}"
    group: "{{GROUP|def(omit)}}"
  become: "{{ _become.become }}"
  when: DIR != OPT and OPT_DIR is deftruthy
  vars:
    _dest: "{{OPT}}/src"
    _become: "{{ _dest|become_calc }}"
