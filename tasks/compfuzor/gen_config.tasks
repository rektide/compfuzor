---
# gen_config.tasks — generic config subsystem artifact synthesis.
#
# Merges the 'config' subsystem's contrib (defined in vars/common.yaml) into
# the global BINS/ETC_DIRS/ENV_LIST/STATUSES artifacts. The config subsystem
# provides config-<KEY>.sh, disable-<KEY>.sh, enable-<KEY>.sh, and
# status-config.sh scripts, parameterized by CONFIG_KEY/CONFIG_MERGE/CONFIG_EXT.
#
# Can be imported with scoped vars to run for different config keys:
#   import_tasks: gen_config.tasks
#   vars:
#     CONFIG_KEY: mcp
#     CONFIG_MERGE: json-merge
#     CONFIG_EXT: json
# See gen_mcp.tasks for a working example.

- name: "Compfuzor: synthesize compiled config artifacts"
  set_fact:
    DIRS: "{{ DIRS | merge_list(SUBSYSTEM.config.contrib.DIRS, preset='append_unique') }}"
    ETC_FILES: "{{ ETC_FILES | merge_list(SUBSYSTEM.config.contrib.ETC_FILES, preset='append') }}"
    BINS: "{{ BINS | merge_list(SUBSYSTEM.config.contrib.BINS | annotate_bins('config'), preset='bins_generated') }}"
    STATUSES: "{{ STATUSES | merge_list(SUBSYSTEM.config.contrib.STATUSES, preset='append_unique') }}"
    PKGS: "{{ PKGS | merge_list(SUBSYSTEM.config.contrib.PKGS, preset='append_unique') }}"
  when: DROPINS is defined or CONFIGS is defined

- name: "Compfuzor: synthesize legacy config subsystem artifacts"
  set_fact:
    ETC_DIRS: "{{ lookup('merge_subsys', id='config', contrib='ETC_DIRS') }}"
    BINS: "{{ lookup('merge_subsys', id='config', domain=CONFIG_KEY, contrib='BINS') }}"
    ENV_LIST: "{{ lookup('merge_subsys', id='config', contrib='ENV_LIST') }}"
    STATUSES: "{{ STATUSES | merge_list(['status-config.sh'], preset='append') }}"
  when:
    - DROPINS is not defined and CONFIGS is not defined
    - lookup('subsys', id='config', get='active', default=false) | bool
