---
# Password subsystem: generate, persist, and expose passwords as variables.
#
# Activated when PASSWORDS is a non-empty list. Replaces the password
# generation previously embedded in vars_base.tasks.
#
# Input:
#   PASSWORDS:       list of password names or objects with keys:
#                    name      — variable name AND filename (required for objects)
#                    format    — shell command to generate value (default: pwgen)
#                    per_host  — generate independently per host (default: false/shared)
#                    file      — override persistence for this entry (default: PASSWORDS_FILES)
#                                true  → persist even if PASSWORDS_FILES is false
#                                false → don't persist even if PASSWORDS_FILES is true
#   PASSWORD_LENGTH: length for default pwgen passwords (default: 20)
#   PASSWORDS_DIR:   where to read/write persisted passwords (default: {{ETC}}/secrets)
#   PASSWORDS_FILES: global default for persisting password files (default: false)
#
# Examples:
#   PASSWORDS:
#     - clickhouse
#     - name: token
#       format: 'echo "$(pwgen -As 6 1).$(pwgen -As 16 1)"'
#     - name: host_secret
#       per_host: true
#     - name: ephemeral
#       file: false                # generated fresh every run
#
# Shared passwords are generated ONCE (run_once on the first host) and
# distributed to all hosts. Per-host passwords generate independently.
#
# Output:
#   PASSWORD:       dict {name: value}
#   <name>:         each password also set as individual top-level variable

- name: "Passwords: normalize entries"
  set_fact:
    _password_entries: >-
      {%- set entries = [] -%}
      {%- for pw in PASSWORDS | default([]) -%}
        {%- if pw is mapping -%}
          {%- set _ = entries.append({
            'name': pw.name,
            'cmd': pw.format | default('pwgen ' ~ (PASSWORD_LENGTH | default(20)) ~ ' -N 1'),
            'per_host': pw.per_host | default(false) | bool,
            'persist': pw.file | default(PASSWORDS_FILES | default(false) | bool) | bool
          }) -%}
        {%- else -%}
          {%- set _ = entries.append({
            'name': pw,
            'cmd': 'pwgen ' ~ (PASSWORD_LENGTH | default(20)) ~ ' -N 1',
            'per_host': false,
            'persist': PASSWORDS_FILES | default(false) | bool
          }) -%}
        {%- endif -%}
      {%- endfor -%}
      {{ entries }}
    _password_names: >-
      {%- set names = [] -%}
      {%- for pw in PASSWORDS | default([]) -%}
        {%- set _ = names.append(pw.name if pw is mapping else pw) -%}
      {%- endfor -%}
      {{ names }}
    _password_shared_names: >-
      {%- set names = [] -%}
      {%- for pw in PASSWORDS | default([]) -%}
        {%- if pw is mapping -%}
          {%- if not (pw.per_host | default(false) | bool) -%}
            {%- set _ = names.append(pw.name) -%}
          {%- endif -%}
        {%- else -%}
          {%- set _ = names.append(pw) -%}
        {%- endif -%}
      {%- endfor -%}
      {{ names }}
    _password_perhost_names: >-
      {%- set names = [] -%}
      {%- for pw in PASSWORDS | default([]) -%}
        {%- if pw is mapping and (pw.per_host | default(false) | bool) -%}
          {%- set _ = names.append(pw.name) -%}
        {%- endif -%}
      {%- endfor -%}
      {{ names }}
  when: PASSWORDS | default([]) | length > 0

- name: "Passwords: generate shared (once)"
  shell: |
    pw_dir="{{ PASSWORDS_DIR | default(ETC ~ '/secrets') }}"
    mkdir -p "$pw_dir"
    {% for pw in (_password_entries | default([])) if not pw.per_host %}
    {% if pw.persist %}
    dest="$pw_dir/{{ pw.name }}"
    if [ -s "$dest" ]; then
      tr -d '\n\r' < "$dest"
      echo
    else
      {{ pw.cmd }}
    fi
    {% else %}
    {{ pw.cmd }}
    {% endif %}
    {% endfor %}
  register: _password_shared_values
  run_once: true
  changed_when: false
  when: _password_shared_names | default([]) | length > 0

- name: "Passwords: generate per-host"
  shell: |
    pw_dir="{{ PASSWORDS_DIR | default(ETC ~ '/secrets') }}"
    mkdir -p "$pw_dir"
    {% for pw in (_password_entries | default([])) if pw.per_host %}
    {% if pw.persist %}
    dest="$pw_dir/{{ pw.name }}"
    if [ -s "$dest" ]; then
      tr -d '\n\r' < "$dest"
      echo
    else
      {{ pw.cmd }}
    fi
    {% else %}
    {{ pw.cmd }}
    {% endif %}
    {% endfor %}
  register: _password_perhost_values
  changed_when: false
  when: _password_perhost_names | default([]) | length > 0

- name: "Passwords: set PASSWORD dict"
  set_fact:
    PASSWORD: >-
      {%- set shared = dict((_password_shared_names | default([])) | zip((_password_shared_values.stdout_lines | default([])))) -%}
      {%- set perhost = dict((_password_perhost_names | default([])) | zip((_password_perhost_values.stdout_lines | default([])))) -%}
      {{ shared | combine(perhost) | combine(PASSWORD | default({})) }}
  when: _password_names | default([]) | length > 0

- name: "Passwords: unpack into individual variables"
  set_fact:
    "{{ item }}": "{{ PASSWORD[item] }}"
  loop: "{{ _password_names }}"
  when: _password_names | default([]) | length > 0

- name: "Passwords: persist to disk"
  copy:
    dest: "{{ PASSWORDS_DIR | default(ETC ~ '/secrets') }}/{{ item.name }}"
    content: "{{ PASSWORD[item.name] }}"
    mode: "0600"
  loop: "{{ _password_entries | default([]) }}"
  when: item.persist | default(false)
