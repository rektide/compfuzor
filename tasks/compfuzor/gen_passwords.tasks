---
# Password subsystem: generate, persist, and expose passwords as variables.
#
# Activated when PASSWORDS is a non-empty list. Replaces the password
# generation previously embedded in vars_base.tasks.
#
# Input:
#   PASSWORDS:       list of password names or objects with name/format keys.
#                    Strings default to pwgen. Objects allow custom generators:
#                      - token
#                      - name: agentToken
#                        format: 'echo "$(pwgen -As 6 1).$(pwgen -As 16 1)"'
#   PASSWORD_LENGTH: length for default pwgen passwords (default: 20)
#   PASSWORDS_DIR:   where to read/write persisted passwords (default: {{ETC}}/secrets)
#   PASSWORDS_FILES: if true, persist password files to PASSWORDS_DIR
#
# Output:
#   PASSWORD:       dict {name: value} (backward compat — clickhouse uses PASSWORD.clickhouse)
#   <name>:         each password also set as individual top-level variable
#                   (for lookup('vars', name) in ETC_FILES var: references)

- name: "Passwords: normalize entries"
  set_fact:
    _password_entries: >-
      {%- set entries = [] -%}
      {%- for pw in PASSWORDS | default([]) -%}
        {%- if pw is mapping -%}
          {%- set _ = entries.append({
            'name': pw.name,
            'cmd': pw.format | default('pwgen ' ~ (PASSWORD_LENGTH | default(20)) ~ ' -N 1')
          }) -%}
        {%- else -%}
          {%- set _ = entries.append({
            'name': pw,
            'cmd': 'pwgen ' ~ (PASSWORD_LENGTH | default(20)) ~ ' -N 1'
          }) -%}
        {%- endif -%}
      {%- endfor -%}
      {{ entries }}
    _password_names: >-
      {%- set names = [] -%}
      {%- for pw in PASSWORDS | default([]) -%}
        {%- set _ = names.append(pw.name if pw is mapping else pw) -%}
      {%- endfor -%}
      {{ names }}
  when: PASSWORDS | default([]) | length > 0

- name: "Passwords: generate or load from disk"
  shell: |
    pw_dir="{{ PASSWORDS_DIR | default(ETC ~ '/secrets') }}"
    mkdir -p "$pw_dir"
    {% for pw in _password_entries %}
    dest="$pw_dir/{{ pw.name }}"
    if [ -s "$dest" ]; then
      tr -d '\n\r' < "$dest"
      echo
    else
      {{ pw.cmd }}
    fi
    {% endfor %}
  register: _password_values
  changed_when: false
  when: _password_names | default([]) | length > 0

- name: "Passwords: set PASSWORD dict"
  set_fact:
    PASSWORD: "{{ dict(_password_names | zip(_password_values.stdout_lines)) | combine(PASSWORD | default({})) }}"
  when: _password_names | default([]) | length > 0

- name: "Passwords: unpack into individual variables"
  set_fact:
    "{{ item }}": "{{ PASSWORD[item] }}"
  loop: "{{ _password_names }}"
  when: _password_names | default([]) | length > 0

- name: "Passwords: persist to disk"
  copy:
    dest: "{{ PASSWORDS_DIR | default(ETC ~ '/secrets') }}/{{ item }}"
    content: "{{ PASSWORD[item] }}"
    mode: "0600"
  loop: "{{ _password_names }}"
  when:
    - _password_names | default([]) | length > 0
    - PASSWORDS_FILES | default(false) | bool
