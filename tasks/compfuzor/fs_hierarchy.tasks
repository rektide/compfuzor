---
- name: "Create {{include|upper}} directories & files, source temporary facts"
  set_fact:
  args:
    _dir: "{{FS_CONTAINERED|truthy|ternary(relative, fsh)}}"
    _link: "{{FS_CONTAINERED|truthy|ternary(fsh, relative)}}"
    _upper: "{{upper}}"
    _vals: "{{vals}}"
    _stat:
      results:
        - stat:
            exists: False
        - stat:
            exists: False
  vars:
    fsh: "{{lookup('vars', include|upper)}}"
    relative: "{{DIR}}/{{include}}"
    upper: "{{include|upper}}"
    names:
      sDir: "{{upper}}S_DIR"
      dirs: "{{upper}}_DIRS"
      dir: "{{upper}}_DIR"
      files: "{{upper}}_FILES"
      d: "{{upper}}_D"
      prop: "{{upper}}_PROP"
      bypass: "{{upper}}_BYPASS"
      linkProp: "{{upper}}_LINK_PROP"
      linkBypass: "{{upper}}_LINK_BYPASS"
    vals:
      sDir: "{{lookup('vars', names.sDir, default=False)}}"
      dirs: "{{lookup('vars', names.dirs, default=False)}}"
      dir: "{{lookup('vars', names.dir, default=False)}}"
      d: "{{lookup('vars', names.d, default=False)}}"
      files: "{{lookup('vars', names.files, default=False)}}"
      prop: "{{lookup('vars', names.prop, default={})}}"
      bypass: "{{(DIR_BYPASS is deftruthy or lookup('vars', names.bypass, default=False)) or not (names.sDir or names.dirs or names.dir or names.files or names.d)}}"
      linkProp: "{{lookup('vars', names.linkProp, default={})}}"
      linkBypass: "{{(DIR_LINK_BYPASS is deftruthy or lookup('vars', names.linkBypass, default=False)) or not (names.sDir or names.dirs or names.dir or names.files or names.d)}}"
- name: "Test for {{_upper}} dir and link"
  stat:
    path: "{{item}}"
  register: _stat
  when: FS_DIR_TOP_PROPER is deffalsy
  with_items:
  - "{{_dir}}"
  - "{{_link}}"


# create main directory
- name: "Create top {{_upper}} directory"
  file:
    path: "{{_dir}}"
    state: directory
    mode: "{{_vals.props.mode|def(DIRMODE, omit, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  become: "{{ _become.become }}"
  when: not _vals.bypass and not _stat.results[0].stat.exists
  vars:
    _become: "{{ _dir|become_calc(owner=_vals.prop.owner|def(OWNER, falsy=True), group=_vals.prop.group|def(GROUP, falsy=True)) }}"

# link include dir into DIR
- name: "Link {{_upper}}"
  file:
    src: "{{_dir}}"
    dest: "{{_link}}"
    state: link
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  become: "{{ _become.become }}"
  when: not _vals.linkBypass and not _stat.results[1].stat.exists
  vars:
    _become: "{{ _link|become_calc(owner=_vals.prop.owner|def(OWNER, falsy=True), group=_vals.prop.group|def(GROUP, falsy=True)) }}"

# create subdirs
- name: "Create {{_upper}} subdirs and .d dirs"
  file:
    path: "{{subdir}}"
    state: directory
    mode: "{{item.mode|def(_vals.prop.mode, DIRMODE, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  with_items: "{{ _subdir_items }}"
  become: "{{ _become.become }}"
  when: _subdir_items | length > 0
  vars:
    _subdir_items: "{{ _vals.dirs|normalize(to='list') + _vals.d|normalize(to='list') }}"
    subdir: "{{_dir}}/{{item.name|def(item)}}" 
    _become: "{{ subdir|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"

# include files
- name: "Do {{_upper}} lineinfile"
  lineinfile:
    dest: "{{dest}}"
    line: "{{item.line}}"
    regexp: "{{item.regexp|default('^' + item.line)}}"
    create: "{{item.create|default(True)}}"
    state: "{{item.state|default(omit)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  with_items: "{{ _vals.files|normalize(to='list') }}"
  become: "{{ _become.become }}"
  when: item.line is deftruthy
  vars:
    dest: "{{item.dest|def(item.name, item)|defaultDir(_dir)}}"
    _become: "{{ dest|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"

- name: "Create {{_upper}} files"
  copy:
    content: "{{all if item.copyDir is deffalsy  else omit}}"
    src: "{{src|default(False) if item.copyDir|default(False) == True else omit}}"
    dest: "{{dest}}"
    mode: "{{item.mode|def(_vals.prop.mode, FILEMODE, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
    backup: "{{item.backup|def(FS_BACKUP, False)}}"
    # TODO: ansible 2.3+:
    #mode: "{{COPY_MODE|default(preserve)}}"
  loop: "{{ _vals.files|normalize(to='list') }}"
  loop_control:
    index_var: idx
  become: "{{ _become.become }}"
  when: item.line is deffalsy and (item.once is deffalsy or dest is not exists)
  vars:
    srcDir: "files/{{ TYPE }}"
    src: "{{ item.src|def(item.name, item, falsy=True)|defaultDir('files/'+TYPE) if not item.srcTemplate is defined else item.srcTemplate|unsafety|defaultDir('files/'+TYPE) }}"
    files: "{{include|upper}}_FILES"
    content: "{{item.content|def('')|unsafety }}"
    yaml: "{{item.yaml|to_nice_yaml if item.yaml is deftruthy else ''}}"
    json: "{{item.json|to_nice_json if item.json is deftruthy else '' }}"
    fileType: "{{'file' if item.raw is deftruthy else 'template'}}"
    isFile: "{{not (item.content|def or item.yaml|def or item.json|def or item.var|def or item.copyDir|def)}}"
    file: "{{lookup(fileType, item.src|def(item.name, item, falsy=True)|defaultDir(srcDir)) if isFile else '' }}"
    var: "{{lookup('vars', item.var) if item.var|def else '' }}"
    all: "{{ content + file + var + yaml + json}}"
    dest: "{{ item.dest|def(item.name, item.src, item, falsy=True)|defaultDir(_dir) if not item.destTemplate is defined else item.destTemplate|unsafety|defaultDir(_dir) }}"
    _become: "{{ dest|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"

- name: "Assemble .d directory"
  assemble:
    src: "{{dest}}.d"
    dest: "{{dest}}"
    backup: "{{item.backup|default(True)}}"
    mode: "{{item.mode|def(_vals.prop.mode, FILEMODE, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  become: "{{ _become.become }}"
  when: _vals.d
  with_items: "{{ _vals.d|normalize(to='list') }}"
  vars:
    dest: "{{_dir}}/{{item.dest|def(item.name, item)}}"
    _become: "{{ dest|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"
