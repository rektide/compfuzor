---
- name: "Create {{include|upper}} directories & files, source temporary facts"
  set_fact:
  args:
    _dir: "{{_compiled_family.materialized_root}}"
    _link: "{{_compiled_family.exposure_root}}"
    _upper: "{{upper}}"
    _vals: "{{vals}}"
    _stat:
      results:
        - stat:
            exists: False
        - stat:
            exists: False
  vars:
    fsh: "{{lookup('vars', include|upper)}}"
    relative: "{{DIR}}/{{include}}"
    # family_key / *_name overrides let a pseudo-family (the DIR-rooted
    # FILES/DIRS pair) ride this machinery without the <X>_FILES naming.
    _compiled_family: "{{ _ARTIFACTS.families[family_key|def((include|upper) + '_FILES')] }}"
    upper: "{{include|upper}}"
    names:
      sDir: "{{ sDir_name|def(upper + 'S_DIR') }}"
      dirs: "{{ dirs_name|def(upper + '_DIRS') }}"
      dir: "{{ dir_name|def(upper + '_DIR') }}"
      files: "{{ files_name|def(upper + '_FILES') }}"
      prop: "{{ prop_name|def(upper + '_PROP') }}"
      bypass: "{{ bypass_name|def(upper + '_BYPASS') }}"
      linkProp: "{{ linkProp_name|def(upper + '_LINK_PROP') }}"
      linkBypass: "{{ linkBypass_name|def(upper + '_LINK_BYPASS') }}"
    vals:
      sDir: "{{lookup('vars', names.sDir, default=False)}}"
      dirs: "{{lookup('vars', names.dirs, default=False)}}"
      dir: "{{lookup('vars', names.dir, default=False)}}"
      files: "{{ _compiled_family.entries }}"
      prop: "{{lookup('vars', names.prop, default={})}}"
      bypass: "{{(DIR_BYPASS is deftruthy or lookup('vars', names.bypass, default=False)) or not (names.sDir or names.dirs or names.dir or names.files)}}"
      linkProp: "{{lookup('vars', names.linkProp, default={})}}"
      linkBypass: "{{(DIR_LINK_BYPASS is deftruthy or lookup('vars', names.linkBypass, default=False)) or not (names.sDir or names.dirs or names.dir or names.files)}}"
- name: "Test for {{_upper}} dir and link"
  stat:
    path: "{{item}}"
  register: _stat
  when: FS_DIR_TOP_PROPER is deffalsy
  with_items:
  - "{{_dir}}"
  - "{{_link}}"


# create main directory
- name: "Create top {{_upper}} directory"
  file:
    path: "{{_dir}}"
    state: directory
    mode: "{{_vals.prop.mode|def(DIRMODE, omit, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  become: "{{ _become.become }}"
  when: not _vals.bypass and not _stat.results[0].stat.exists
  vars:
    _become: "{{ _dir|become_calc(owner=_vals.prop.owner|def(OWNER, falsy=True), group=_vals.prop.group|def(GROUP, falsy=True)) }}"

# link include dir into DIR. Skipped when materialized and exposure roots are
# the same path (the DIR-rooted FILES family: the file lives in DIR itself,
# there is nothing to link).
- name: "Link {{_upper}}"
  file:
    src: "{{_dir}}"
    dest: "{{_link}}"
    state: link
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  become: "{{ _become.become }}"
  when: >-
    _dir != _link
    and not _vals.linkBypass
    and not _stat.results[1].stat.exists
  vars:
    _become: "{{ _link|become_calc(owner=_vals.prop.owner|def(OWNER, falsy=True), group=_vals.prop.group|def(GROUP, falsy=True)) }}"

# create subdirs
- name: "Create {{_upper}} subdirs"
  file:
    path: "{{subdir}}"
    state: directory
    mode: "{{item.mode|def(_vals.prop.mode, DIRMODE, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  with_items: "{{ _subdir_items }}"
  become: "{{ _become.become }}"
  when: _subdir_items | length > 0
  vars:
    _subdir_items: "{{ _vals.dirs|normalize(to='list') }}"
    # Absolute entries (e.g. config-contributed BINS_DIR/processors) are used
    # as-is; only relative names join under the family materialized root.
    _subdir: "{{item.name|def(item)}}"
    subdir: "{{_subdir if _subdir is match('^/') else _dir ~ '/' ~ _subdir}}"
    _become: "{{ subdir|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"

# include files
- name: "Do {{_upper}} lineinfile"
  lineinfile:
    dest: "{{artifact.resolved_dest}}"
    line: "{{item.line}}"
    regexp: "{{item.regexp|default('^' + item.line)}}"
    create: "{{item.create|default(True)}}"
    state: "{{item.state|default(omit)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  loop: "{{ _vals.files }}"
  loop_control:
    loop_var: artifact
  become: "{{ _become.become }}"
  when: item.line is deftruthy
  vars:
    item: "{{ artifact.item }}"
    _become: "{{ artifact.resolved_dest|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"

# parent dirs for nested file entries. The template module used to do this
# implicitly for FILES; copy does not, and nested names (FILES `sub/file`,
# ETC_FILES `applications/x.desktop`) are legal compiled destinations.
- name: "Create {{_upper}} file parent dirs"
  file:
    path: "{{parent}}"
    state: directory
    mode: "{{_vals.prop.mode|def(DIRMODE, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  loop: "{{ _vals.files }}"
  loop_control:
    loop_var: artifact
  become: "{{ _become.become }}"
  when: item.line is deffalsy and parent is not exists
  vars:
    item: "{{ artifact.item }}"
    parent: "{{artifact.resolved_dest|dirname}}"
    _become: "{{ parent|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"

- name: "Create {{_upper}} files"
  copy:
    content: "{{all if item.copyDir is deffalsy  else omit}}"
    src: "{{src|default(False) if item.copyDir|default(False) == True else omit}}"
    dest: "{{dest}}"
    mode: "{{item.mode|def(_vals.prop.mode, FILEMODE, falsy=True)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
    backup: "{{item.backup|def(FS_BACKUP, False)}}"
    # TODO: ansible 2.3+:
    #mode: "{{COPY_MODE|default(preserve)}}"
  loop: "{{ _vals.files }}"
  loop_control:
    loop_var: artifact
    index_var: idx
  become: "{{ _become.become }}"
  when: item.line is deffalsy and (item.once is deffalsy or dest is not exists)
  vars:
    item: "{{ artifact.item }}"
    srcDir: "files/{{ TYPE }}"
    src: "{{ item.src|def(item.name, item, falsy=True)|defaultDir('files/'+TYPE) if not item.srcTemplate is defined else item.srcTemplate|unsafety|defaultDir('files/'+TYPE) }}"
    files: "{{include|upper}}_FILES"
    content: "{{item.content|def('')|unsafety }}"
    yaml: "{{item.yaml|to_nice_yaml if item.yaml is deftruthy else ''}}"
    json: "{{item.json|to_nice_json if item.json is deftruthy else '' }}"
    fileType: "{{'file' if item.raw is deftruthy else 'template'}}"
    isFile: "{{not (item.content|def or item.yaml|def or item.json|def or item.var|def or item.copyDir|def)}}"
    file: "{{lookup(fileType, item.src|def(item.name, item, falsy=True)|defaultDir(srcDir)) if isFile else '' }}"
    var: "{{lookup('vars', item.var) if item.var|def else '' }}"
    all: "{{ content + file + var + yaml + json}}"
    dest: "{{ artifact.resolved_dest }}"
    _become: "{{ artifact.resolved_dest|become_calc(owner=item.owner|def(_vals.prop.owner, OWNER, falsy=True), group=item.group|def(_vals.prop.group, GROUP, falsy=True)) }}"
