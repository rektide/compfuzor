- debug: "msg='Compfuzor: create base files'"
- name: "Creating base `DIR`"
  file:
    path: "{{DIR}}"
    state: directory
    mode: "{{DIRMODE}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  become: "{{ _become.become }}"
  vars:
    _become: "{{ DIR|become_calc }}"
  when: DIR is deftruthy(True)
- name: "Creating `DIRS`"
  file:
    path: "{{_dest}}"
    state: directory
    mode: "{{DIRMODE}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  with_items: "{{DIRS}}"
  become: "{{ _become.become }}"
  when: DIRS is deftruthy
  vars:
    _dest: "{{item|defaultDir(DIR)}}"
    _become: "{{ _dest|become_calc }}"
- name: "Creating `FILES`"
  # someone wanted a basename here but eclipse has a ../content & like yeah, that's fine. locales holds the blame. see cf0fdccf0c.
  template:
    src: "files/{{TYPE}}/{{item.src|def(item.name, item)}}"
    dest: "{{dest}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  with_items: "{{FILES}}"
  become: "{{ _become.become }}"
  when: FILES is defined and FILES is not mapping and item.line is deffalsy
  vars:
    dest: "{{DIR}}/{{item.dest|def(item.name, item)}}"
    _become: "{{ dest|become_calc }}"
- name: "Creating `FILES` mapping"
  template:
    src: "files/{{TYPE}}/{{ item[1] }}"
    dest: "{{_dest}}"
    owner: "{{OWNER|def(omit)}}"
    group: "{{GROUP|def(omit)}}"
  with_items: "{{FILES.items()}}"
  become: "{{ _become.become }}"
  when: FILES is defmapping
  vars:
    _dest: "{{ DIR+'/' if item[0]|first != '/' and item[0]|first != '~' else '' }}{{item[0]}}"
    _become: "{{ _dest|become_calc }}"

- name: "File lineinfile"
  lineinfile:
    dest: "{{dest}}"
    line: "{{item.line}}"
    regexp: "{{item.regexp|default('^' + item.line)}}"
    create: "{{item.create|default(True)}}"
    state: "{{item.state|default(omit)}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  with_items: "{{FILES}}"
  become: "{{ _become.become }}"
  when: FILES is defined and FILES is not mapping and item.line is deftruthy
  vars:
    dest: "{{item.name|defaultDir(DIR)}}"
    _become: "{{ dest|become_calc(owner=item.owner|def(OWNER, falsy=True), group=item.group|def(GROUP, falsy=True)) }}"
