- debug: "msg='Compfuzor: create base files'"
- name: "Creating base `DIR`"
  file:
    path: "{{DIR}}"
    state: directory
    mode: "{{DIRMODE}}"
    owner: "{{ _become.owner }}"
    group: "{{ _become.group }}"
  become: "{{ _become.become }}"
  vars:
    _become: "{{ DIR|become_calc }}"
  when: DIR is deftruthy(True)
# DIRS and FILES no longer have bespoke tasks here: they materialize through
# fs_hierarchy as the DIR-rooted pseudo-family (see compfuzor.includes), the
# same writer and policy as ETC_FILES and friends.
