- name: "Compfuzor: add go repo"
  set_fact:
    REPOS: "{{ REPOS|merge_dict(repo) }}"
    goRepos: "{{ goRepos|default('') }} {{GOPATH_DIR}}"
  loop: "{{ REPO_GO|normalize(to='list') }}"
  vars:
    go_url: "{{item}}"
    repo: "{ '{{GOPATH_DIR}}': '{{item}}' }"
  when: REPO_GO is deftruthy
- name: 'add ENV gopath, BIN build.sh and LINKS repo/bin'
  set_fact:
    BINS: "{{ BINS | merge_list(goBins | annotate_bins('go'), preset='bins_generated') }}"
    ENV: "{{ ENV | merge_dict(goEnvs, preset='overlay') }}"
    LINKS: "{{ LINKS|default({})|combine({\"{{REPO_DIR}}/bin\": \"{{BINS_DIR}}\"}) }}"
  vars:
    goBins: [{
        "name": "{{GO_BUILD|default('build.sh')}}",
        "run": True,
        "basedir": "{{REPO_DIR}}",
        "exec": "for r in {{goRepos}} ; do (cd $r; go install ./...) ; done"
      }]
    goEnvs: {"GOPATH": "{{REPO_DIR}}"}
    goRepo: "{{REPO_DIR}}/bin"
