---
- debug: "msg='Compfuzor: fetch hg repository as git'"
- name: "Fetch fast-export importer"
  git: repo="https://github.com/frej/fast-export" dest="{{OPTS_DIR}}/fast-export-git"
- name: "Wipe temporary hg directory"
  file: path="{{REPO_DIR|def(DIR, falsy=True)}}/hg" state=absent
- name: "Create temporary hg directory"
  file: path="{{REPO_DIR|def(DIR, falsy=True)}}/hg" state=directory
- name: "Fetch/clone hg repository"
  shell: chdir="{{REPO_DIR|def(DIR, falsy=True)}}" hg clone "{{HG_REPO}}" "hg"
- name: "Initialize `DIR` as git"
  shell: chdir="{{REPO_DIR|def(DIR, falsy=True)}}" git init .
- name: "Import temporary hg"
  shell: chdir="{{REPO_DIR|def(DIR, falsy=True)}}" "{{OPTS_DIR}}/fast-export-git/hg-fast-export.sh" -r "{{REPO_DIR|def(DIR, falsy=True)}}/hg"
- name: "Erase temporary hg directory"
  file: path="{{REPO_DIR|def(DIR, falsy=True)}}/hg" state=absent
- name: "Load current head"
  shell: chdir="{{REPO_DIR|def(DIR, falsy=True)}}" git checkout HEAD
