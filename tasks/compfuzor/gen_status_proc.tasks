---
# Merge the proc-backed provider published by sub_status_proc. gen_status
# remains the final status.sh compositor.

- name: "Compfuzor: synthesize proc-backed status artifacts"
  set_fact:
    BINS: "{{ lookup('merge_subsys', id='status_proc', contrib='BINS') }}"
    STATUSES: "{{ lookup('merge_subsys', id='status_proc', contrib='STATUSES') }}"
  when: lookup('subsys', id='status_proc', domain='status', get='active', default=false) | bool
