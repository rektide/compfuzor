---
# Select typed STATUS_PROC declarations into purpose-built status reporters.
# The leaves contribute only BINS and STATUSES; gen_status remains the final
# status.sh compositor.

- name: "Compfuzor: fail invalid STATUS_PROC collection"
  fail:
    msg: "STATUS_PROC must be a list of typed status checks"
  when:
    - not _status_proc_bypassed
    - STATUS_PROC is defined
    - STATUS_PROC is not sequence or STATUS_PROC is string
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"

- name: "Compfuzor: fail non-mapping STATUS_PROC entries"
  fail:
    msg: "STATUS_PROC entries must be mappings"
  loop: "{{ STATUS_PROC if (STATUS_PROC is defined and STATUS_PROC is sequence and STATUS_PROC is not string) else [] }}"
  when:
    - not _status_proc_bypassed
    - item is not mapping
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"

- name: "Compfuzor: fail invalid STATUS_PROC entry headers"
  fail:
    msg: "STATUS_PROC entries require a unique lowercase name and a known check"
  loop: "{{ STATUS_PROC | default([]) }}"
  when:
    - not _status_proc_bypassed
    - item is mapping
    - >-
      item.name is not defined
      or item.name is not string
      or item.name is not match('^[a-z0-9][a-z0-9._-]*$')
      or item.check is not defined
      or item.check is not string
      or item.check not in _status_proc_check_kinds
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"
    _status_proc_check_kinds: [mainpid-env, exe-current]

- name: "Compfuzor: fail duplicate STATUS_PROC names"
  fail:
    msg: "STATUS_PROC entry names must be unique"
  when:
    - not _status_proc_bypassed
    - _status_proc_names | length != (_status_proc_names | unique | length)
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"
    _status_proc_names: "{{ STATUS_PROC | default([]) | map(attribute='name') | list }}"

- name: "Compfuzor: fail invalid STATUS_PROC unit checks"
  fail:
    msg: "STATUS_PROC {{ item.check }} '{{ item.name }}' requires a .service unit and manager system or user"
  loop: "{{ STATUS_PROC | default([]) }}"
  when:
    - not _status_proc_bypassed
    - >-
      item.unit is not defined
      or item.unit is not string
      or item.unit is not match('^.+[.]service$')
      or (
        item.manager is defined
        and (item.manager is not string or item.manager not in ['system', 'user'])
      )
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"

- name: "Compfuzor: fail invalid mainpid-env checks"
  fail:
    msg: "STATUS_PROC mainpid-env '{{ item.name }}' requires a non-empty expected mapping"
  loop: "{{ STATUS_PROC | default([]) | selectattr('check', 'equalto', 'mainpid-env') | list }}"
  when:
    - not _status_proc_bypassed
    - item.expected is not defined or item.expected is not mapping or item.expected | length == 0
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"

- name: "Compfuzor: fail invalid mainpid-env variable names"
  fail:
    msg: "STATUS_PROC mainpid-env '{{ item.name }}' contains an invalid environment variable name"
  loop: "{{ STATUS_PROC | default([]) | selectattr('check', 'equalto', 'mainpid-env') | list }}"
  when:
    - not _status_proc_bypassed
    - item.expected.keys() | reject('match', '^[A-Za-z_][A-Za-z0-9_]*$') | list | length > 0
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"

- name: "Compfuzor: fail invalid exe-current checks"
  fail:
    msg: "STATUS_PROC exe-current '{{ item.name }}' requires an absolute expected executable path"
  loop: "{{ STATUS_PROC | default([]) | selectattr('check', 'equalto', 'exe-current') | list }}"
  when:
    - not _status_proc_bypassed
    - >-
      item.expected is not defined
      or item.expected is not string
      or not item.expected.startswith('/')
  vars:
    _status_proc_bypassed: "{{ (STATUS_PROC_BYPASS is deftruthy) or (STATUS_BYPASS is deftruthy) }}"

- name: "Compfuzor: synthesize proc-backed status leaves"
  set_fact:
    BINS: "{{ lookup('merge_subsys', id=_status_proc_subsystem, contrib='BINS') }}"
    STATUSES: "{{ lookup('merge_subsys', id=_status_proc_subsystem, contrib='STATUSES') }}"
  loop:
    - status_proc_mainpid_env
    - status_proc_exe_current
  loop_control:
    loop_var: _status_proc_subsystem
  when: lookup('subsys', id=_status_proc_subsystem, domain='status', get='active', default=false) | bool
