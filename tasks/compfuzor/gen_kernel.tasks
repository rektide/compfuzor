---
- name: "Compfuzor: fail invalid kernel input"
  fail:
    msg: "{{ _kernel_errors | join('; ') }}"
  when: _kernel_any_input and (KERNEL_BYPASS is not deftruthy) and (_kernel_errors | length > 0)
  vars:
    _kernel_module_items: "{{ KERNEL_MODULES | dict2items if KERNEL_MODULES is defmapping else [] }}"
    _kernel_error_checks:
      - msg: "KERNEL_MODULES must be a mapping"
        failed: "{{ KERNEL_MODULES is defined and KERNEL_MODULES is not mapping }}"
      - msg: "KERNEL_SYSCTL must be a mapping"
        failed: "{{ KERNEL_SYSCTL is defined and KERNEL_SYSCTL is not mapping }}"
      - msg: "KERNEL_SYSFS must be a mapping"
        failed: "{{ KERNEL_SYSFS is defined and KERNEL_SYSFS is not mapping }}"
      - msg: "KERNEL_PARAMS must be a list"
        failed: "{{ KERNEL_PARAMS is defined and KERNEL_PARAMS is not sequence }}"
      - msg: "KERNEL_MODULES entries must be mappings"
        failed: "{{ (_kernel_module_items | selectattr('value', 'mapping') | list | length) != (_kernel_module_items | length) }}"
      - msg: "KERNEL_MODULES.<module>.params must be a mapping when defined"
        failed: >-
          {{
            (
              _kernel_module_items
              | selectattr('value.params', 'defined')
              | selectattr('value.params', 'mapping')
              | list
              | length
            )
            !=
            (
              _kernel_module_items
              | selectattr('value.params', 'defined')
              | list
              | length
            )
          }}
    _kernel_errors: "{{ _kernel_error_checks | selectattr('failed', 'truthy') | map(attribute='msg') | list }}"
    _kernel_any_input: "{{ KERNEL_MODULES is defined or KERNEL_SYSCTL is defined or KERNEL_SYSFS is defined or KERNEL_PARAMS is defined }}"

- name: "Compfuzor: synthesize kernel leaf subsystem artifacts"
  set_fact:
    ETC_FILES: "{{ [ETC_FILES | default([]), _kernel_modprobe_contrib.ETC_FILES | default([]), _kernel_sysctl_contrib.ETC_FILES | default([]), _kernel_sysfs_contrib.ETC_FILES | default([]), _kernel_params_contrib.ETC_FILES | default([]), _kernel_bls_contrib.ETC_FILES | default([])] | merge_list('append') }}"
    # gen_bins.tasks runs after this synthesis and composes these build-* and
    # install-* scripts into generic action entry points. Each contributed bin
    # is tagged `subsystem: kernel` so >=2 leaves in an action roll up into a
    # <action>-kernel.sh compositor (build-kernel.sh / install-kernel.sh /
    # apply-kernel.sh) rather than flattening into the top action compositor.
    BINS: "{{ [BINS | default([]), _kernel_modprobe_contrib.BINS | default([]) | map('combine', {'subsystem': 'kernel'}) | list, _kernel_sysctl_contrib.BINS | default([]) | map('combine', {'subsystem': 'kernel'}) | list, _kernel_sysfs_contrib.BINS | default([]) | map('combine', {'subsystem': 'kernel'}) | list, _kernel_params_contrib.BINS | default([]) | map('combine', {'subsystem': 'kernel'}) | list, _kernel_bls_contrib.BINS | default([]) | map('combine', {'subsystem': 'kernel'}) | list] | merge_list('bins_generated') }}"
    ENV: "{{ _kernel_modprobe_contrib.ENV | merge_dict(_kernel_sysctl_contrib.ENV, _kernel_sysfs_contrib.ENV, _kernel_params_contrib.ENV, _kernel_bls_contrib.ENV, ENV, skip='all') }}"
    ENV_LIST: "{{ [ENV_LIST | default([]), _kernel_modprobe_contrib.ENV_LIST | default([]), _kernel_sysctl_contrib.ENV_LIST | default([]), _kernel_sysfs_contrib.ENV_LIST | default([]), _kernel_params_contrib.ENV_LIST | default([]), _kernel_bls_contrib.ENV_LIST | default([])] | merge_list('append_unique') }}"
    PKGS: "{{ [PKGS | default([]), _kernel_modprobe_contrib.PKGS | default([]), _kernel_sysctl_contrib.PKGS | default([]), _kernel_sysfs_contrib.PKGS | default([]), _kernel_params_contrib.PKGS | default([]), _kernel_bls_contrib.PKGS | default([])] | merge_list('append_unique') }}"
    STATUSES: "{{ (STATUSES | default([])) + _kernel_status_reporters }}"
  when: _kernel_any_active
  vars:
    # ordered kernel reporters, contributed to STATUSES for status.sh
    _kernel_status_reporters: "{{ (['status-sysctl.ts'] if _kernel_sysctl_active else []) + (['status-modules.ts'] if _kernel_modprobe_active else []) + (['status-sysfs.ts'] if _kernel_sysfs_active else []) + (['status-cmdline.ts'] if _kernel_params_active else []) + (['status-ramoops.sh'] if _kernel_bls_active else []) }}"
    _kernel_modprobe_active: "{{ lookup('subsys', id='kernel_modprobe', domain='kernel', get='active', default=false) | bool }}"
    _kernel_sysctl_active: "{{ lookup('subsys', id='kernel_sysctl', domain='kernel', get='active', default=false) | bool }}"
    _kernel_sysfs_active: "{{ lookup('subsys', id='kernel_sysfs', domain='kernel', get='active', default=false) | bool }}"
    _kernel_params_active: "{{ lookup('subsys', id='kernel_params', domain='kernel', get='active', default=false) | bool }}"
    _kernel_bls_active: "{{ lookup('subsys', id='kernel_bls', domain='kernel', get='active', default=false) | bool }}"
    _kernel_any_active: "{{ _kernel_modprobe_active or _kernel_sysctl_active or _kernel_sysfs_active or _kernel_params_active or _kernel_bls_active }}"
    _kernel_modprobe_contrib: "{{ lookup('subsys', id='kernel_modprobe', domain='kernel', get='contrib', default={}) if _kernel_modprobe_active else {} }}"
    _kernel_sysctl_contrib: "{{ lookup('subsys', id='kernel_sysctl', domain='kernel', get='contrib', default={}) if _kernel_sysctl_active else {} }}"
    _kernel_sysfs_contrib: "{{ lookup('subsys', id='kernel_sysfs', domain='kernel', get='contrib', default={}) if _kernel_sysfs_active else {} }}"
    _kernel_params_contrib: "{{ lookup('subsys', id='kernel_params', domain='kernel', get='contrib', default={}) if _kernel_params_active else {} }}"
    _kernel_bls_contrib: "{{ lookup('subsys', id='kernel_bls', domain='kernel', get='contrib', default={}) if _kernel_bls_active else {} }}"
