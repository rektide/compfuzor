- name: "Compfuzor: precreate git dir"
  file:
    path: "{{dest}}"
    state: directory
    owner: "{{ OWNER|default(_cf_user_id)|default(omit) }}"
    group: "{{ GROUP|default(ansible_group_id)|default(omit) }}"
  #become: "{{dest|should_become(OWNER|default(), _cf_user_id, GROUP|default(), _cf_user_gid)}}"
  when: REPO|default(False) is truthy or REPOS|default(False) is truthy
  vars:
    dest: "{{ GIT_DIR|default(REPO_DIR, true)|default(DIR, true) }}"

- name: "Compfuzor: normalize git repositories into git_repos"
  set_fact:
    git_repos: "{{ git_repos_rendered | from_json }}"
  vars:
    base_dest: "{{ GIT_DIR|default(REPO_DIR, true)|default(DIR, true) }}"
    repos_base: "{{ REPO_DIR|default(DIR, true) }}"
    git_repos_rendered: |
      {%- set ns = namespace(items=[]) -%}
      {%- if REPO|default(False) is truthy -%}
      {%-   set _ = ns.items.append({'repo': REPO, 'dest': base_dest, 'become': false}) -%}
      {%- endif -%}
      {%- if REPOS|default(False) is mapping -%}
      {%-   for it in (REPOS | normalize(to='items')) -%}
      {%-     set d = it.key | defaultDir(repos_base) -%}
      {%-     set _ = ns.items.append({'repo': it.value, 'dest': d, 'become': COMFUZOR_SHOULD_BECOME|default(BECOME|default(d|should_become(OWNER|default(), _cf_user_id, GROUP|default(), _cf_user_gid)))|bool}) -%}
      {%-   endfor -%}
      {%- endif -%}
      {%- if REPOS|default(False) and (REPOS is not mapping) -%}
      {%-   for it in REPOS -%}
      {%-     set url = it.repo | default(it) -%}
      {%-     set d = repos_base ~ '/' ~ (url | basename | regex_replace('\.git$', '')) -%}
      {%-     set _ = ns.items.append({'repo': url, 'dest': d, 'reference': it.reference | default(''), 'become': COMFUZOR_SHOULD_BECOME|default(BECOME|default(d|should_become(OWNER|default(), _cf_user_id, GROUP|default(), _cf_user_gid)))|bool}) -%}
      {%-   endfor -%}
      {%- endif -%}
      {{ ns.items | to_json }}

- name: "Compfuzor: fetch git repositories"
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    track_submodules: "{{ GIT_SUBMODULES|default(False) }}"
    accept_hostkey: "{{ GIT_ACCEPT|default(False) }}"
    depth: "{{ GIT_DEPTH|default(omit) }}"
    version: "{{ GIT_VERSION|default(omit) }}"
    update: "{{ GIT_UPDATE|default(omit) }}"
    reference: "{{ item.reference|defaultDir(SRCS_DIR) if item.reference|default(False) else omit }}"
  become: "{{ item.become|default(false)|bool }}"
  loop: "{{ git_repos|default([]) }}"
  when: >
    git_repos|default([])|length > 0
    and not GIT_BYPASS|default(False)
    and not REPO_BYPASS|default(False)

- name: "Compfuzor: colocate jj on cloned git repositories"
  shell: |
    command -v jj >/dev/null 2>&1 || exit 0
    jj git init
    jj commit -m "{{ JJ_COMMIT_MSG|default('compfuzor: jj init') }}"
  args:
    chdir: "{{ item.dest }}"
    creates: "{{ item.dest }}/.jj"
  loop: "{{ git_repos|default([]) }}"
  when: >
    git_repos|default([])|length > 0
    and not GIT_BYPASS|default(False)
    and not REPO_BYPASS|default(False)
    and not JJ_BYPASS|default(False)
