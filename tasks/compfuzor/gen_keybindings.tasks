---
- name: "Compfuzor: package named keybinding declarations and shared target installers"
  set_fact:
    _keybindings_compiled: >-
      {{ KEYBINDING_ACTIONS | default({}) | resolve |
         keybindings_compile(KEYBINDINGS | default({}) | resolve,
           KEYBINDING_CONSUMERS | default({}) | resolve,
           _keybinding_targets | resolve,
           KEYBINDING_PRODUCER | default(NAME), ETC, BINS_DIR,
           KEYBINDING_ORDER | default(100), KEYBINDING_CONTEXT | default('user'),
           KEYBINDING_SCOPE | default('user'), (CONFIGS | default({}) | length > 0),
           ACTION_AUDIENCES | default(None)) }}
  vars:
    # Declared (including empty) producer resources opt into common wiring.
    # A consumer's own resources are its local layer, not a producer install.
    # Explicit targets still win, including empty maps/lists and combined roles.
    _keybinding_targets: >-
      {{ KEYBINDING_TARGETS | default(None) }}
- name: "Compfuzor: synthesize keybinding artifacts"
  set_fact:
    ETC_FILES: "{{ ETC_FILES | merge_list(_keybindings_compiled.files, preset='append') }}"
    BINS: "{{ BINS | merge_list(_keybindings_compiled.bins | annotate_bins('keybindings'), preset='bins_generated') }}"
    DIRS: "{{ DIRS | merge_list(_keybindings_compiled.dirs, preset='append_unique') }}"
    PKGS: "{{ PKGS | default([]) | merge_list(_keybindings_compiled.pkgs, preset='append_unique') }}"
