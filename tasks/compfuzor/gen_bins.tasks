---
# Action script conventions (bypass, guards, progress reporting):
# see doc/subsys.md § Action runner.
#
# Rendered env-setting snippets should default to NOT stomping an existing
# value, and only force-overwrite when COMPFUZOR_ENV_OVERWRITE is set. The spec is:
#   1/true/y/yes/* (case-insensitive)        -> overwrite ALL vars
#   otherwise: comma-separated glob patterns  -> overwrite only matching var names
#                                                  (e.g. WATCHMAN_*,SSH_AUTH_SOCK)
# The reference impl is the `_compfuzor_env_overwrite` helper generated by
# zim_fragment's env kind; it lets an outer session or the systemd user manager
# (SYSTEMD_ENV) win unless the operator opts into specific generated values.
- name: "Compfuzor: synthesize bin action compositors"
  set_fact:
    BINS: "{{ BINS | merge_list(BINS | bin_composers, preset='bins_generated') }}"
  when: ACTION_AUDIENCES is not defined and BINS | bin_composers | length > 0

- name: "Compfuzor: compile audience action families"
  set_fact:
    _ACTION_AUDIENCES: "{{ BINS | action_audiences_compile(ACTION_AUDIENCES) }}"
  when: ACTION_AUDIENCES is defined

- name: "Compfuzor: contribute audience action families"
  set_fact:
    BINS: "{{ _ACTION_AUDIENCES.bins }}"
    ETC_FILES: "{{ (ETC_FILES | default([])) + _ACTION_AUDIENCES.etc_files }}"
    ETC_DIRS: "{{ (ETC_DIRS | default([])) + _ACTION_AUDIENCES.etc_dirs }}"
    DIRS: "{{ (DIRS | default([])) + (_ACTION_AUDIENCES.bin_dirs | map('defaultDir', BINS_DIR) | list) }}"
  when: ACTION_AUDIENCES is defined

- name: "Compfuzor: resolve absent bin tombstones"
  set_fact:
    _bins_by_state: "{{ BINS | partition_bin_states }}"

- name: "Compfuzor: publish materialized and absent bins"
  set_fact:
    BINS: "{{ _bins_by_state.present }}"
    BINS_ABSENT: "{{ _bins_by_state.absent }}"
