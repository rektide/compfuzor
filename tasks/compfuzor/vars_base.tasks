- debug: "msg='Compfuzor: source base variables'"

- name: "Include usermode common vars (first, to win over system defaults)"
  # Load BEFORE common.yaml so user-mode dir overrides (SRVS_DIR/VARS_DIR/
  # ETCS_DIR/...) are the FIRST writer. include_defaults only sets UNDEFINED
  # vars, so this gives user paths priority over common.yaml's /srv, /var/lib,
  # /etc/opt -- while still respecting anything the playbook itself set
  # (playbook vars are already in task_vars and are never overwritten). Values
  # are lazy templates (SRVS_DIR -> USERMODE_SRVS_DIR -> HOMEDIR) that resolve
  # when DIR/ETC are computed below, after common.yaml has run.
  include_defaults:
    file: vars/common.user.yaml
  when: USERMODE is deftruthy

- name: "include common vars"
  include_defaults:
    file: vars/common.yaml

- name: "read in compfuzor base vars"
  # found ansible vars for these:
  #cat /etc/machine-id
  #dpkg --print-architecture
  shell: |
    xdg-user-dir DESKTOP
    xdg-user-dir DOCUMENTS
    xdg-user-dir DOWNLOAD
    xdg-user-dir MUSIC
    xdg-user-dir PUBLICSHARE
    xdg-user-dir PICTURES
    xdg-user-dir TEMPLATES
    xdg-user-dir VIDEOS
    uname -r
    (dpkg --print-architecture && dpkg --print-foreign-architectures) | tr "\n" ","; echo
    uuidgen
    echo $XDG_DATA_HOME
    echo $XDG_CONFIG_HOME
    echo $XDG_STATE_HOME
    echo $XDG_DATA_DIRS
    echo $XDG_CONFIG_DIRS
    echo $XDG_CACHE_HOME
    echo $XDG_RUNTIME_DIR
    cat /etc/machine-id
    uname -m
    id -un
    id -g
    date +'%Y.%m.%dT%H:%M:%S%z'
    nproc
    echo last
  register: COMPFUZOR_BASE
  changed_when: False

- name: set compfuzor user facts
  set_fact:
    _cf_user_id: "{{COMPFUZOR_BASE.stdout_lines[20]}}"
    _cf_user_gid: "{{COMPFUZOR_BASE.stdout_lines[21]|int}}"
  changed_when: False

- name: set compfuzor base facts
  set_fact:
    XDG_DESKTOP_DIR: "{{COMPFUZOR_BASE.stdout_lines[0]}}"
    XDG_DOCUMENTS_DIR: "{{COMPFUZOR_BASE.stdout_lines[1]}}"
    XDG_DOWNLOAD_DIR: "{{COMPFUZOR_BASE.stdout_lines[2]}}"
    XDG_MUSIC_DIR: "{{COMPFUZOR_BASE.stdout_lines[3]}}"
    XDG_PICTURES_DIR: "{{COMPFUZOR_BASE.stdout_lines[4]}}"
    XDG_PUBICSHARE_DIR: "{{COMPFUZOR_BASE.stdout_lines[5]}}"
    XDG_TEMPLATES_DIR: "{{COMPFUZOR_BASE.stdout_lines[6]}}"
    XDG_VIDEOS_DIR: "{{COMPFUZOR_BASE.stdout_lines[7]}}"
    # ref: https://wiki.archlinux.org/title/XDG_Base_Directory
    XDG_DATA_HOME: "{{ XDG_DATA_HOME|def(COMPFUZOR_BASE.stdout_lines[11], HOMEDIR + '/.local/share', falsy=True) }}"
    XDG_CONFIG_HOME: "{{ XDG_CONFIG_HOME|def(COMPFUZOR_BASE.stdout_lines[12], HOMEDIR + '/.config', falsy=True) }}"
    XDG_STATE_HOME: "{{ XDG_STATE_HOME|def(COMPFUZOR_BASE.stdout_lines[13], HOMEDIR + '/.local/state', falsy=True) }}"
    XDG_DATA_DIRS: "{{ XDG_DATA_DIRS|def(COMPFUZOR_BASE.stdout_lines[14], '/usr/local/share:/usr/share', falsy=True) }}"
    XDG_CONFIG_DIRS: "{{ XDG_CONFIG_DIRS|def(COMPFUZOR_BASE.stdout_lines[15], '/etc/xdg', falsy=True) }}"
    XDG_CACHE_HOME: "{{ XDG_CACHE_HOME|def(COMPFUZOR_BASE.stdout_lines[16], HOMEDIR + '/.cache', falsy=True) }}"
    XDG_RUNTIME_DIR: "{{ XDG_RUNTIME_DIR|def(COMPFUZOR_BASE.stdout_lines[17], '/run/user/' + _cf_user_id, falsy=True) }}"

    MACHINE_ID: "{{MACHINE_ID|default(machineId)}}"
    SUBINSTANCE: "{{SUBINSTANCE|default(omit)}}"
    ARCH: "{{ARCH|default(arch)}}"
    NATIVE_ARCH: "{{NATIVE_ARCH|default(arch)}}"
    ARCHS: "{{ARCHS|default(archs)}}"
    KERNEL_RELEASE: "{{KERNEL_RELEASE|default(kernel)}}"
    UUID: "{{uuid}}"
    TIMESTAMP_CF: "{{TIMESTAMP_CF|default(timestamp)}}"
    NAME: "{{name_}}"
    TYPE: "{{TYPE|default(name_)}}"
    PREFIX_DIR: "{{prefix}}"
    DIR: "{{prefix}}/{{name_}}"
    hostnum: "{% for i in ansible_play_batch %}{{ loop.index0 if ansible_play_batch[loop.index0] == inventory_hostname else '' }}{% endfor %}"
    type: "{{type|default(typeDetect)}}"
  changed_when: False
  failed_when: False
  vars:
    typeDetect: "{{ (lookup('file', '/proc/self/cmdline') | regex_replace('\u0000',' ')).split() | select('match','^.*[.]pb$') | list | first | regex_replace('^.*\\.(.*)\\.pb$', '\\1')}}"
    # above via https://stackoverflow.com/questions/59981172/how-to-get-the-current-file-name-in-ansible
    type_: "{{type|default(typeDetect)}}" # used to default to opt
    #machineId: "{{COMPFUZOR_BASE.stdout_lines[]}}"
    machineId: "{{COMPFUZOR_BASE.stdout_lines[18]|default(lookup('file', '/etc/machine-id')|trim, True)}}"
    arch: "{{COMPFUZOR_BASE.stdout_lines[19]|default(lookup('pipe', 'uname -m'), True)}}"
    kernel: "{{COMPFUZOR_BASE.stdout_lines[8]}}"
    archs: "{{COMPFUZOR_BASE.stdout_lines[9][:-1] | split(',')}}"
    uuid: "{{UUID|default(COMPFUZOR_BASE.stdout_lines[10])}}"

    # computed
    timestamp: "{{TIMESTAMP_CF|default(COMPFUZOR_BASE.stdout_lines[22])}}"
    instanceName: "{{'-' if INSTANCE else ''}}{{INSTANCE|default('')}}"
    subinstance: "{{(SUBINSTANCE if SUBINSTANCE is string else MACHINE_ID) if SUBINSTANCE is deftruthy else ''}}"
    subinstanceName: "{{'-' if subinstance is deftruthy else ''}}{{subinstance|default('')}}"
    name_: "{{NAME|default(TYPE + instanceName + subinstanceName)}}"
    prefixType: "{{lookup('vars', type_|upper+'S_DIR', default='')}}"
    prefixDir: "{{DIR|default()|dirname}}"
    prefix: "{{PREFIX_DIR|def(prefixDir, prefixType, falsy=True)}}"
    dir: "{{DIR|default(prefix + '/' + name_)}}"

- name: "include type {{type|default('[none]')|lower}} vars"
  include_defaults:
    file: "{{item}}"
  loop:
    - vars/common.yaml
    - vars/types/{{type|lower}}.yaml

- name: "Set archive download paths"
  set_fact:
    REPO_ORG: "{{ REPO|default('')|regex_replace('^[^/]+//[^/]+/', '')|regex_replace('/.*$', '') }}"
    REPO_NAME: "{{ REPO|default('')|regex_replace('.*/', '')|regex_replace('\\.git$', '') }}"
  when: REPO|def is string


# vars_type does a more expanded version
# that ideally we can reduce to a single pass run-all-found
#- name: "Include configset or extra type vars"
#  include_defaults: file="{{ item }}"
#  with_first_found:
#  - "private/{{configset}}.yaml"
#  - "private/{{TYPE}}.yaml"
#  - "examples-private/{{configset}}.yaml"
#  - "examples-private/{{TYPE}}.yaml"
#  - "vars/empty.yaml"

#- name: "Select default username {{TYPE}}"
#  set_fact: USER="{{TYPE}}"
#  when: not USER|default(False)

- name: convert LINKS dict into well specified form
  set_fact:
    LINKS: "{{LINKS|normalize(to='items', key_name='dest', value_name='src')}}"
  when: LINKS is defmapping
