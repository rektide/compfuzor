---
- name: "Compfuzor: source source variables"
  set_fact: 
  args:
    WITHS: "{{ '--with-'+WITH|join(' --with-') if WITH is deftruthy else '' }}"
    ENABLES: "{{ '--enable-'+ENABLE|join(' --enable-') if ENABLE is deftruthy else '' }}"
    PREPREFIX: "{{ DEST|def(NAME, TYPE) }}"
    CORES: "{{ CORES|default(COMPFUZOR_BASE.stdout_lines[24]|int)|default(8) }}"
    GOPATH: "{{DIR}}"
    SRC: "{{ARCHIVE_SRC if ARCHIVE_DOWNLOAD is deftruthy and REPO is defined else SRC|default(omit)}}"

- name: "set PREFIX var"
  set_fact: PREFIX="{{ ('--prefix='+(OPTS_DIR+'/' if PREPREFIX|first != '/' and PREPREFIX|first !='~' else '')+PREPREFIX) if PREFIX is deffalsy else PREFIX }}"

- name: "set INSTANCE default for src type"
  set_fact: INSTANCE=src
  when: type == "src" and INSTANCE is deffalsy

- name: "repo setting"
  set_fact: "{{item.key|upper|replace('-', '_')}}_DIR={{ REPO_DIR|def(DIR, falsy=True)+'/' if item.key|first != '/' and item.key|first != '~' else '' }}{{item.key}}"
  with_items: "{{ REPOS|normalize(to='list') }}"
  when: REPOS is sequence and not lookup('deftruthy', item) and item.key is deftruthy
- name: "create src directory if get_urls"
  set_fact:
    SRC_DIRS: True
  when: GET_URLS is deftruthy and SRC_DIR is deffalsy
