---
# Single-pass synthesis of version-manager artifacts.
#
# The version file (.tool-versions / mise.toml) is a REAL file directly in
# DIR -- not under DIR/etc, and no DIR-level symlink. The only link is the
# repo-root one: asdf/mise call getcwd(), which resolves through the DIR/repo
# symlink to the *physical* archive path and then walks ancestors, so
# DIR/.tool-versions is invisible from inside the repo. Archive mode declares
# the link even on the initial clone; the repository lane checks ownership and
# arranges a clone-local exclude before the link is ever applied.
#
# Emission uses an ETC_FILES entry with an absolute dest override (the same
# trick as readme's README.md): the FILES family writes via template src,
# not inline content, so ETC_FILES-with-dest is how a DIR-rooted generated
# file is expressed today.
#
# `force` stays at the LINKS default (false): non-archive behavior is
# unchanged. The archive repository lane removes the link from the compiled
# plan if upstream tracks that path or another local file occupies it.
#
# Set TOOL_VERSIONS_LINK_BYPASS=True to skip emitting the repo-root link
# entirely (the DIR file is unaffected). Use this when the repo owns its own
# version config and you don't want compfuzor touching it.
#
# Artifact lists (_tv_etc, _tv_links, _mise_etc, _mise_links, _mise_bins) are
# defined as YAML literals under `vars:` and rendered through
# merge_list(resolve=True). This keeps the dict construction in YAML (readable,
# diffs cleanly) while ensuring template strings inside -- which reference
# task-local vars like _tv_path / _tool_versions -- are rendered at THIS task's
# scope before being stored as facts. Without resolve=, ansible leaves nested
# template strings raw and re-renders them later when the task-local vars are
# out of scope (e.g. inside fs_hierarchy), producing '_tool_versions is
# undefined'.
- name: "Compfuzor: synthesize version-manager artifacts"
  set_fact:
    ETC_FILES: >-
      {{ (
        (_tv_etc if _tv_active else []) +
        (_mise_etc if _mise_active else [])
      ) | merge_list(ETC_FILES, preset='append', resolve=True) }}
    LINKS: >-
      {{ ((_tv_links if _tv_active else []) +
          (_mise_links if _mise_active else []))
         | attribute_links(NAME, 'tool_versions')
         | merge_list(LINKS, preset='append', resolve=True) }}
    BINS: >-
      {{ (_mise_bins if _mise_active else [])
         | attribute_bins(NAME, 'tool_versions')
         | merge_list(BINS, preset='bins_generated', resolve=True) }}
  vars:
    _tool_versions: "{{ TOOL_VERSIONS | merge_dict(preset='tool_versions_overlay') }}"
    _mise_versions: "{{ MISE_VERSIONS | merge_dict(preset='tool_versions_overlay') }}"
    _tv_active: "{{ _tool_versions is deflengthy and _mise_versions is not deflengthy }}"
    _mise_active: "{{ _mise_versions is deflengthy }}"
    _has_repo: >-
      {{ ((REPO_DIR | default('')) and (REPO_DIR is directory)) or
         (ARCHIVE_DOWNLOAD is deftruthy and REPO is deftruthy and
          GIT_BYPASS is deffalsy and REPO_BYPASS is deffalsy and JJ_BYPASS is deffalsy) }}
    _link_repo: "{{ _has_repo and not (TOOL_VERSIONS_LINK_BYPASS|default(False)|bool) }}"
    _tv_path: "{{ DIR + '/.tool-versions' }}"
    _tv_repo_link:
      src: "{{ _tv_path }}"
      dest: "{{ GIT_DIR if ARCHIVE_DOWNLOAD is deftruthy and REPO is deftruthy else REPO_DIR }}/.tool-versions"
    _tv_links: "{{ [_tv_repo_link] if _link_repo else [] }}"
    _tv_etc:
      - name: ".tool-versions"
        dest: "{{ _tv_path }}"
        content: |
          {% for target, version in _tool_versions.items() %}
          {{ target }} {{ version if version != True else lookup('vars', target | upper + '_VERSION') }}
          {% endfor %}
    _mise_path: "{{ DIR + '/mise.toml' }}"
    _mise_repo_link:
      src: "{{ _mise_path }}"
      dest: "{{ GIT_DIR if ARCHIVE_DOWNLOAD is deftruthy and REPO is deftruthy else REPO_DIR }}/mise.toml"
    _mise_links: "{{ [_mise_repo_link] if _link_repo else [] }}"
    _mise_tools: "{{ _tool_versions | merge_dict(_mise_versions, preset='tool_versions_overlay') }}"
    _mise_etc:
      - name: "mise.toml"
        dest: "{{ _mise_path }}"
        content: |
          [tools]
          {% for target, version in _mise_tools.items() %}
          {{ target }} = {{ (version if version != True else (lookup('vars', target | upper + '_VERSION') | default('latest'))) | to_json }}
          {% endfor %}
    _mise_bins:
      - name: install.sh
        early: |
          mise install
  when: _tv_active or _mise_active
