---
# Single-pass synthesis of version-manager artifacts.
#
# asdf/mise call getcwd(), which resolves through the DIR/repo symlink to
# the *physical* archive path and then walks ancestors. So DIR/.tool-versions
# is invisible from inside the repo. When a checkout actually exists at
# REPO_DIR, also link .tool-versions/mise.toml into the repo root.
#
# `force` stays at the LINKS default (false): a real file already in the repo
# is NOT clobbered -- ansible fails loudly rather than stomping. The cross-file
# case (we emit .tool-versions, repo has mise.toml, or vice versa) is left
# intentionally unhandled/undefined.
#
# Set TOOL_VERSIONS_LINK_BYPASS=True to skip emitting the repo-root link
# entirely (the DIR/.tool-versions link is unaffected). Use this when the repo
# owns its own version config and you don't want compfuzor touching it.
#
# Artifact lists (_tv_etc, _tv_links, _mise_etc, _mise_links, _mise_bins) are
# defined as YAML literals under `vars:` and rendered through
# merge_list(resolve=True). This keeps the dict construction in YAML (readable,
# diffs cleanly) while ensuring template strings inside -- which reference
# task-local vars like _tv_path / _tool_versions -- are rendered at THIS task's
# scope before being stored as facts. Without resolve=, ansible leaves nested
# template strings raw and re-renders them later when the task-local vars are
# out of scope (e.g. inside fs_hierarchy), producing '_tool_versions is
# undefined'.
- name: "Compfuzor: synthesize version-manager artifacts"
  set_fact:
    ETC_FILES: >-
      {{ (
        (_tv_etc if _tv_active else []) +
        (_mise_etc if _mise_active else [])
      ) | merge_list(ETC_FILES, preset='append', resolve=True) }}
    LINKS: >-
      {{ (
        (_tv_links if _tv_active else []) +
        (_mise_links if _mise_active else [])
      ) | merge_list(LINKS, preset='append', resolve=True) }}
    BINS: >-
      {{ (_mise_bins if _mise_active else [])
         | merge_list(BINS, preset='bins_generated', resolve=True) }}
  vars:
    _tool_versions: "{{ TOOL_VERSIONS | merge_dict(preset='tool_versions_overlay') }}"
    _mise_versions: "{{ MISE_VERSIONS | merge_dict(preset='tool_versions_overlay') }}"
    _tv_active: "{{ _tool_versions is deflengthy and _mise_versions is not deflengthy }}"
    _mise_active: "{{ _mise_versions is deflengthy }}"
    _has_repo: "{{ (REPO_DIR | default('')) and (REPO_DIR is directory) }}"
    _link_repo: "{{ _has_repo and not (TOOL_VERSIONS_LINK_BYPASS|default(False)|bool) }}"
    _tv_path: "{{ DIR + '/etc/.tool-versions' }}"
    _tv_base_link:
      src: "{{ _tv_path }}"
      dest: ".tool-versions"
    _tv_repo_link:
      src: "{{ _tv_path }}"
      dest: "{{ REPO_DIR }}/.tool-versions"
    _tv_links: "{{ [_tv_base_link] + ([_tv_repo_link] if _link_repo else []) }}"
    _tv_etc:
      - name: ".tool-versions"
        content: |
          {% for target, version in _tool_versions.items() %}
          {{ target }} {{ version if version != True else lookup('vars', target | upper + '_VERSION') }}
          {% endfor %}
    _mise_path: "{{ DIR + '/etc/mise.toml' }}"
    _mise_base_link:
      src: "{{ _mise_path }}"
      dest: "mise.toml"
    _mise_repo_link:
      src: "{{ _mise_path }}"
      dest: "{{ REPO_DIR }}/mise.toml"
    _mise_links: "{{ [_mise_base_link] + ([_mise_repo_link] if _link_repo else []) }}"
    _mise_tools: "{{ _tool_versions | merge_dict(_mise_versions, preset='tool_versions_overlay') }}"
    _mise_etc:
      - name: "mise.toml"
        content: |
          [tools]
          {% for target, version in _mise_tools.items() %}
          {{ target }} = {{ (version if version != True else (lookup('vars', target | upper + '_VERSION') | default('latest'))) | to_json }}
          {% endfor %}
    _mise_bins:
      - name: install.sh
        early: |
          mise install
  when: _tv_active or _mise_active
