---
# Pin synthesis only: no repo-root link, version file, or mise install is
# executed during the Ansible render. build-mise.sh handles them at build time.
# The bin is first in the raw BINS run lane; phase: packages likewise puts it
# ahead of main-phase build-nodejs/build-rust in the build.sh compositor.
- name: "Compfuzor: synthesize version-manager build step"
  set_fact:
    BINS: "{{ [_build_mise_bin] | merge_list(BINS, preset='bins_generated', resolve=True) }}"
  vars:
    _tool_versions: "{{ TOOL_VERSIONS | merge_dict(preset='tool_versions_overlay') }}"
    _mise_versions: "{{ MISE_VERSIONS | merge_dict(preset='tool_versions_overlay') }}"
    _mise_active: "{{ _mise_versions is deflengthy }}"
    _pin_name: "{{ 'mise.toml' if _mise_active else '.tool-versions' }}"
    _mise_tools: "{{ _tool_versions | merge_dict(_mise_versions, preset='tool_versions_overlay') }}"
    _pin_content: |-
      {% if _mise_active %}
      [tools]
      {% for target, version in _mise_tools.items() %}
      {{ target }} = {{ (version if version != True else (lookup('vars', target | upper + '_VERSION') | default('latest'))) | to_json }}
      {% endfor %}
      {% else %}
      {% for target, version in _tool_versions.items() %}
      {{ target }} {{ version if version != True else lookup('vars', target | upper + '_VERSION') }}
      {% endfor %}
      {% endif %}
    _build_mise_bin:
      name: build-mise.sh
      run: "{{ BUILD_RUN_BYPASS is deffalsy and BINS_RUN_BYPASS is deffalsy }}"
      phase: packages
      bypass: [BUILD, MISE]
      basedir: false
      generated: |
        # Write a deployment-owned pin at *build* time; do not rewrite it
        # when its content already matches the requested versions.
        _cf_mise_pin={{ (DIR ~ '/' ~ _pin_name) | quote }}
        _cf_mise_repo={{ (REPO_DIR | default('')) | quote }}
        _cf_mise_tmp=$(mktemp "${_cf_mise_pin}.tmp.XXXXXXXX")
        trap 'rm -f -- "${_cf_mise_tmp}"' EXIT
        printf '%s' '{{ _pin_content | b64encode }}' | base64 --decode > "${_cf_mise_tmp}"
        if ! cmp -s -- "${_cf_mise_pin}" "${_cf_mise_tmp}"; then
            mv -f -- "${_cf_mise_tmp}" "${_cf_mise_pin}"
            chmod 0644 -- "${_cf_mise_pin}"
        fi

        # The physical cwd of builds using DIR/repo is the archive repo root.
        # Exclude the generated link BEFORE it lands: Git and jj both ignore
        # it when untracked, while upstream-tracked files remain visible.
        {% if TOOL_VERSIONS_LINK_BYPASS | default(false) | bool %}
        : # TOOL_VERSIONS_LINK_BYPASS: deploy pin, but leave repo alone
        {% else %}
        # Plain checkouts carry .git as a directory, but jj-colocated and
        # linked-worktree deployments carry a .git *file*; resolve the exclude
        # through git itself (the shared common dir for worktrees). rev-parse
        # may print a repo-relative path; anchor it before use.
        if [ -n "${_cf_mise_repo}" ] && [ "${_cf_mise_repo}" != "${DIR%/}" ] && _cf_mise_exclude=$(git -C "${_cf_mise_repo}" rev-parse --git-path info/exclude 2>/dev/null); then
            case "${_cf_mise_exclude}" in
                /*) ;;
                *) _cf_mise_exclude="${_cf_mise_repo}/${_cf_mise_exclude}" ;;
            esac
            mkdir -p -- "$(dirname -- "${_cf_mise_exclude}")"
            if ! grep -Fxq -- '/{{ _pin_name }}' "${_cf_mise_exclude}" 2>/dev/null; then
                [ ! -s "${_cf_mise_exclude}" ] || [ "$(tail -c 1 "${_cf_mise_exclude}" | wc -l)" -eq 1 ] || printf '\n' >> "${_cf_mise_exclude}"
                printf '/{{ _pin_name }}\n' >> "${_cf_mise_exclude}"
            fi
            _cf_mise_link="${_cf_mise_repo}/{{ _pin_name }}"
            if [ -L "${_cf_mise_link}" ] && [ "$(readlink -- "${_cf_mise_link}")" = "${_cf_mise_pin}" ]; then
                : # already our link
            elif [ -e "${_cf_mise_link}" ] || [ -L "${_cf_mise_link}" ]; then
                _cf_mise_force="${COMPFUZOR_MISE_LINK_FORCE:-}"
                case "${_cf_mise_force,,}" in
                    1|true|yes|on)
                        if [ -d "${_cf_mise_link}" ] && [ ! -L "${_cf_mise_link}" ]; then
                            printf 'COMPFUZOR_REPO_NOTICE\tCannot replace directory %s with version link\n' "${_cf_mise_link}"
                        else
                            printf 'COMPFUZOR_REPO_NOTICE\tFORCED VERSION LINK %s -> %s\n' "${_cf_mise_link}" "${_cf_mise_pin}"
                            ln -sfnT -- "${_cf_mise_pin}" "${_cf_mise_link}"
                        fi
                        ;;
                    *)
                        printf 'COMPFUZOR_REPO_VERSION_SKIP\t%s\n' "${_cf_mise_link}"
                        _cf_mise_diff=$(diff -u --label "repo: ${_cf_mise_link}" --label "compfuzor: ${_cf_mise_pin}" "${_cf_mise_link}" "${_cf_mise_pin}" 2>&1) || :
                        while IFS= read -r _cf_mise_line; do
                            printf 'COMPFUZOR_REPO_NOTICE\t%s\n' "${_cf_mise_line}"
                        done <<< "${_cf_mise_diff}"
                        ;;
                esac
            else
                ln -s -- "${_cf_mise_pin}" "${_cf_mise_link}"
            fi
        fi
        {% endif %}
        cd "${DIR}"
        mise install
  when: _tool_versions is deflengthy or _mise_versions is deflengthy
