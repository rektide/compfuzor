---
- name: "Defaulting SYSTEMD vars"
  set_fact:
  args:
    SYSTEMD_USER: "{{USER if SYSTEMD_USER|def == True else SYSTEMD_USER|default(omit)}}"
    SYSTEMD_SERVICE: "{{serviceNameDefault}}"
    SYSTEMD_UNITTYPES: "{{types}}"
    ETC_DIRS: "{{ETC_DIRS|default(_systemd_has_units|ternary([], omit))}}"
    _systemd_has_units: "{{_systemd_has_units}}"
  vars:
    # Presence per unit type, derived from SYSTEMD_UNITTYPES_ALL so every
    # type (timer, path, slice, ...) is detectable at top level, in
    # SYSTEMD_TYPE_CONFIG order. The previous hardcoded four-boolean zip
    # silently mispaired: zip truncation matched the dnssd flag to timer
    # (SYSTEMD_TYPE_CONFIG's fourth key) and never detected dnssd itself.
    # scope's singular name (SYSTEMD_SCOPE) is the system/user selector, so
    # only its plural SYSTEMD_SCOPES can declare scope units.
    types: >-
      {%- set detected = [] -%}
      {%- for unit_type in SYSTEMD_UNITTYPES_ALL -%}
      {%- set singular = false if unit_type == 'scope' else lookup('vars', 'SYSTEMD_' ~ (unit_type | upper), default=false) -%}
      {%- set plural = lookup('vars', 'SYSTEMD_' ~ SYSTEMD_TYPE_CONFIG[unit_type].var_suffix, default=false) -%}
      {%- if singular is deftruthy or plural is deflengthy -%}
      {%- set _ = detected.append(unit_type) -%}
      {%- endif -%}
      {%- endfor -%}
      {{ detected }}
    _systemd_has_units: "{{ types | length > 0 }}"
    serviceExec: "{{SYSTEMD_SERVICE|default(SYSTEMD_EXEC|def|ternary(True, omit))}}"
    serviceNameDefault: "{{SYSTEMD_SERVICE|default(omit) if SYSTEMD_SERVICE|def != True else NAME}}"

- name: 'Generate systemd unit ETC_FILES'
  set_fact:
    ETC_FILES: "{{ ETC_FILES | merge_list(_etc_file, preset='append', resolve=True) }}"
  when: _has_type and SYSTEMD_INSTALL_BYPASS is deffalsy
  loop: "{{ _loop_items }}"
  vars:
    # SYSTEMD_INSTALL_VALID: enum-validated (see vars/systemd.yaml); a typo
    # would silently drop separate-mode dual rendering.
    _is_separate: "{{ SYSTEMD_INSTALL_VALID == 'separate' }}"
    _loop_items: >-
      {%- if _is_separate -%}
        {%- set items = [] -%}
        {%- for t in SYSTEMD_UNITTYPES -%}
          {%- set _ = items.append({'type': t, 'scope': 'system'}) -%}
          {%- set _ = items.append({'type': t, 'scope': 'user'}) -%}
        {%- endfor -%}
        {{ items }}
      {%- else -%}
        {%- set items = [] -%}
        {%- for t in SYSTEMD_UNITTYPES -%}
          {%- set _ = items.append({'type': t}) -%}
        {%- endfor -%}
        {{ items }}
      {%- endif -%}
    _unit_type: "{{ item.type }}"
    _unit_scope: "{{ item.scope | default('') }}"
    # Effective scope: the loop item's scope in separate mode, else the
    # playbook's SYSTEMD_SCOPE. Deliberately NOT named SYSTEMD_SCOPE: a task
    # var of that name shadows the playbook value, and since `omit` counts
    # as defined, `default(SYSTEMD_SCOPE)` cannot fall back -- the shadow
    # rendered as omit and forced the system hierarchy for plain
    # SYSTEMD_SCOPE: user playbooks. The def form skips undefined, the omit
    # sentinel, and falsy ('' is omit's string form), and validates the
    # result against the scope enum -- a leak or typo now fails the render
    # loudly instead of silently missing every == 'user' branch.
    _scope: "{{ item.scope | def(SYSTEMD_SCOPE, skip_omit=True, falsy=True, enum=['system', 'user']) }}"
    # user-scope renders always get user-relative paths via the fsh lookup
    # (%h/%t, systemd expands at unit-load time): user units are per-user by
    # definition. system-scope renders force the deploy-mode hierarchy.
    _fsh_user: "{{ _scope == 'user' }}"
    _fsh_home: "{{ '%h' if _scope == 'user' else '' }}"
    _fsh_runtime: "{{ '%t' if _scope == 'user' else '' }}"
    _unit_name_var: "SYSTEMD_{{ _unit_type | upper }}"
    _unit_name_val: "{{ lookup('vars', _unit_name_var, default='') }}"
    _unit_name: "{{ _unit_name_val if _unit_name_val and _unit_name_val not in [True, 'True'] else NAME }}"
    _has_type: "{{ _unit_type in SYSTEMD_UNITTYPES }}"
    _separate_suffix: "{{ '-user' if _is_separate and _unit_scope == 'user' else '' }}"
    _unit_filename: "{{ _unit_name }}{{ _separate_suffix }}{{ '@' if SYSTEMD_INSTANCES is deftruthy else '' }}.{{ _unit_type }}"
    # Unit aliases: a unit whose name carries the instance suffix (-git,
    # -main, ...) gets an [Install] Alias= for the base name, so
    # apt-cacher-rs-git.service is also reachable as apt-cacher-rs.service
    # once enabled. SYSTEMD_ALIAS overrides the derived name (type suffix
    # appended when missing); SYSTEMD_ALIAS: false opts out. Instanced (@)
    # units never alias. Two deployments differing only by instance would
    # fight over the base alias (systemd: last enable wins) -- opt one out.
    _alias_base: >-
      {%- set base = _unit_name -%}
      {%- set base = base[:-5] if (_is_separate and _unit_scope == 'user' and base.endswith('-user')) else base -%}
      {%- set base = base[:-(INSTANCE | length + 1)] if (INSTANCE is defined and base.endswith('-' ~ INSTANCE) and base | length > (INSTANCE | length + 1)) else base -%}
      {{- base if base != _unit_name else '' }}
    _alias_name: >-
      {%- if SYSTEMD_ALIAS is defined -%}
        {#- boolean false and string 'false' both mean opt out (extra-vars arrive as strings) -#}
        {%- set control = (SYSTEMD_ALIAS | string) | lower -%}
        {%- if control in ['', 'false', 'none'] -%}{{ '' }}
        {%- else -%}{{ SYSTEMD_ALIAS if '.' in SYSTEMD_ALIAS else SYSTEMD_ALIAS ~ '.' ~ _unit_type }}
        {%- endif -%}
      {%- elif SYSTEMD_INSTANCES is deftruthy or not _alias_base -%}{{ '' }}
      {%- else -%}{{ _alias_base ~ '.' ~ _unit_type }}
      {%- endif -%}
    UNIT_TYPE: "{{ _unit_type }}"
    _raw_vars_base: "{{ (lookup('vars', SYSTEMD_VARS_ROOT, default={}) if SYSTEMD_VARS_ROOT is defined else {}) | combine_iff({'target': target}) }}"
    _raw_vars: "{{ _raw_vars_base | combine({'USERMODE': True}) if _is_separate and _unit_scope == 'user' else _raw_vars_base }}"
    _type_config: "{{ SYSTEMD_TYPE_CONFIG[_unit_type] }}"
    _merged_sections: >-
      {%- set merged = {} -%}
      {%- for section_name in _type_config.sections -%}
        {%- set section_var = 'SYSTEMD_' ~ section_name | upper ~ 'S' -%}
        {%- set default_var = section_var ~ '_DEFAULT' -%}
        {%- set defaults = lookup('vars', default_var, default={}) -%}
        {%- set global_vals = lookup('vars', section_var, default={}) -%}
        {%- set root_vals = _raw_vars.get(section_var, {}) -%}
        {%- set user_vals = global_vals | combine(root_vals, recursive=True) -%}
        {%- set _ = merged.update({section_var: defaults | combine(user_vals, recursive=True)}) -%}
      {%- endfor -%}
      {%- if _alias_name and 'SYSTEMD_INSTALLS' in merged -%}
        {%- set install = merged['SYSTEMD_INSTALLS'] -%}
        {%- set existing = install.get('Alias') -%}
        {%- if existing is sameas false -%}
          {#- explicit false: author suppressed aliases entirely -#}
        {%- else -%}
          {%- set existing_list = (existing if existing is sequence and existing is not string else [existing]) if existing else [] -%}
          {%- if _alias_name not in existing_list -%}
            {%- set _ = install.update({'Alias': existing_list + [_alias_name]}) -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {{ merged }}
    UNIT_VARS: "{{ _raw_vars | combine(_merged_sections) }}"
    _etc_file:
      name: "{{ _unit_filename }}"
      content: "{{ lookup('template', 'files/systemd.unit') }}"

- name: 'Generate systemd unit ETC_FILES from SYSTEMD_ROOTS'
  set_fact:
    ETC_FILES: "{{ ETC_FILES | merge_list(_etc_file, preset='append', resolve=True) }}"
  when:
    - SYSTEMD_ROOTS is defined
    - _has_type_data
    - SYSTEMD_INSTALL_BYPASS is deffalsy
  loop: "{{ _root_type_pairs }}"
  vars:
    _root_type_pairs: >-
      {%- set pairs = [] -%}
      {%- for root_name in SYSTEMD_ROOTS -%}
        {%- set root_data = lookup('vars', root_name, default={}) -%}
        {%- for unit_type in SYSTEMD_UNITTYPES_ALL -%}
          {%- set type_config = SYSTEMD_TYPE_CONFIG[unit_type] -%}
          {%- set var_key = 'SYSTEMD_' ~ type_config.var_suffix -%}
          {%- if root_data[var_key] is defined or root_data['SYSTEMD_' ~ unit_type.upper] is defined -%}
            {%- set _ = pairs.append({'root': root_name, 'type': unit_type}) -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
      {{ pairs }}
    _root_name: "{{ item.root }}"
    _root_data: "{{ lookup('vars', _root_name, default={}) }}"
    _unit_type: "{{ item.type }}"
    _type_config: "{{ SYSTEMD_TYPE_CONFIG[_unit_type] }}"
    _unit_name_key: "SYSTEMD_{{ _unit_type | upper }}"
    _unit_name_val: "{{ _root_data[_unit_name_key] | default(lookup('vars', _unit_name_key, default='')) }}"
    _unit_name: "{{ _unit_name_val if _unit_name_val and _unit_name_val not in [True, 'True'] else NAME }}"
    _root_instances: "{{ _root_data.get('SYSTEMD_INSTANCES', SYSTEMD_INSTANCES | default(False)) }}"
    # Same alias derivation as top-level units: strip the instance suffix,
    # SYSTEMD_ALIAS in the root dict overrides/false opts out.
    _alias_base: >-
      {%- set base = _unit_name -%}
      {%- set base = base[:-(INSTANCE | length + 1)] if (INSTANCE is defined and base.endswith('-' ~ INSTANCE) and base | length > (INSTANCE | length + 1)) else base -%}
      {{- base if base != _unit_name else '' }}
    _alias_name: >-
      {%- set control = _root_data.get('SYSTEMD_ALIAS', SYSTEMD_ALIAS | default('')) -%}
      {%- set control_word = (control | string) | lower -%}
      {%- if control_word in ['', 'false', 'none'] -%}{{ '' }}
      {%- elif control_word -%}{{ control if '.' in (control | string) else control ~ '.' ~ _unit_type }}
      {%- elif _root_instances or not _alias_base -%}{{ '' }}
      {%- else -%}{{ _alias_base ~ '.' ~ _unit_type }}
      {%- endif -%}
    _unit_filename: "{{ _unit_name }}{{ '@' if UNIT_VARS.SYSTEMD_INSTANCES|def(SYSTEMD_INSTANCES, False) else '' }}.{{ _unit_type }}"
    _has_type_data: "{{ _root_data['SYSTEMD_' ~ _type_config.var_suffix] is defined or _root_data[_unit_name_key] is defined }}"
    UNIT_TYPE: "{{ _unit_type }}"
    _merged_sections: >-
      {%- set merged = {} -%}
      {%- for section_name in _type_config.sections -%}
        {%- set section_var = 'SYSTEMD_' ~ section_name | upper ~ 'S' -%}
        {%- set default_var = section_var ~ '_DEFAULT' -%}
        {%- set defaults = lookup('vars', default_var, default={}) -%}
        {%- set global_vals = lookup('vars', section_var, default={}) -%}
        {%- set root_vals = _root_data.get(section_var, {}) -%}
        {%- set user_vals = global_vals | combine(root_vals, recursive=True) -%}
        {%- set _ = merged.update({section_var: defaults | combine(user_vals, recursive=True)}) -%}
      {%- endfor -%}
      {%- if _alias_name and 'SYSTEMD_INSTALLS' in merged -%}
        {%- set install = merged['SYSTEMD_INSTALLS'] -%}
        {%- set existing = install.get('Alias') -%}
        {%- if existing is sameas false -%}
          {#- explicit false: author suppressed aliases entirely -#}
        {%- else -%}
          {%- set existing_list = (existing if existing is sequence and existing is not string else [existing]) if existing else [] -%}
          {%- if _alias_name not in existing_list -%}
            {%- set _ = install.update({'Alias': existing_list + [_alias_name]}) -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {{ merged }}
    UNIT_VARS: "{{ _root_data | combine(_merged_sections) }}"
    _etc_file:
      name: "{{ _unit_filename }}"
      content: "{{ lookup('template', 'files/systemd.unit') }}"

- name: 'Normalize SYSTEMD_DROPIN(S) into _dropin_entries'
  set_fact:
    _dropin_entries: >-
      {%- set entries = [] -%}
      {%- if SYSTEMD_DROPIN is defined -%}
        {%- set _ = entries.append({'key': NAME, 'spec': SYSTEMD_DROPIN}) -%}
      {%- elif SYSTEMD_DROPINS is defined -%}
        {%- if SYSTEMD_DROPINS is mapping -%}
          {%- for k, v in SYSTEMD_DROPINS.items() -%}
            {%- set _ = entries.append({'key': k, 'spec': v}) -%}
          {%- endfor -%}
        {%- else -%}
          {%- for v in SYSTEMD_DROPINS -%}
            {%- set _ = entries.append({'key': v.name | default(NAME), 'spec': v}) -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
      {{ entries }}

- name: 'Validate systemd drop-in targets'
  fail:
    msg: "SYSTEMD drop-in target '{{ _target }}' has unknown type '{{ _unit_type }}' (not in SYSTEMD_TYPE_CONFIG). Set target to a unit name with a known extension (e.g. '{{ _name_guess }}.service')."
  when:
    - _dropin_entries | length > 0
    - _unit_type not in SYSTEMD_UNITTYPES_ALL
  loop: "{{ _dropin_entries }}"
  vars:
    _spec: "{{ item.spec }}"
    _target: "{{ _spec.target | default(NAME ~ '.service') }}"
    _unit_type: "{{ _target.split('.')[-1] }}"
    _name_guess: "{{ _target.split('.')[0] }}"

- name: 'Generate systemd drop-in ETC_FILES'
  set_fact:
    ETC_FILES: "{{ ETC_FILES | merge_list(_etc_file, preset='append', resolve=True) }}"
  when:
    - _dropin_entries | length > 0
    - SYSTEMD_INSTALL_BYPASS is deffalsy
  loop: "{{ _dropin_entries }}"
  vars:
    _spec: "{{ item.spec }}"
    _target: "{{ _spec.target | default(NAME ~ '.service') }}"
    _unit_type: "{{ _target.split('.')[-1] }}"
    _name: "{{ _spec.name | default(item.key) }}"
    _etc_rel: "{{ _target }}.d/{{ _name }}.conf"
    _type_config: "{{ SYSTEMD_TYPE_CONFIG[_unit_type] }}"
    UNIT_TYPE: "{{ _unit_type }}"
    _merged_sections: >-
      {%- set merged = {} -%}
      {%- for section_name in _type_config.sections -%}
        {%- set section_var = 'SYSTEMD_' ~ section_name | upper ~ 'S' -%}
        {%- set _ = merged.update({section_var: _spec[section_var] | default({})}) -%}
      {%- endfor -%}
      {{ merged }}
    UNIT_VARS: "{{ _merged_sections }}"
    _etc_file:
      name: "{{ _etc_rel }}"
      content: "{{ lookup('template', 'files/systemd.unit') }}"

- name: 'Generate systemd drop-in install script'
  set_fact:
    BINS: "{{ BINS | merge_list([_bin_item] | annotate_bins('systemd'), preset='bins_generated') }}"
  when:
    - _dropin_entries | length > 0
    - SYSTEMD_INSTALL_BYPASS is deffalsy
  vars:
    _dropin_rows: >-
      {%- set rows = [] -%}
      {%- for entry in _dropin_entries -%}
        {%- set spec = entry.spec -%}
        {%- set target = spec.target | default(NAME ~ '.service') -%}
        {%- set name = spec.name | default(entry.key) -%}
        {%- set scope = spec.scope | def(SYSTEMD_SCOPE, 'system', skip_omit=True, falsy=True, enum=['system', 'user']) -%}
        {%- set unit_dir = '${HOME}/.config/systemd/user' if scope == 'user' else '/etc/systemd/system' -%}
        {%- set systemctl = 'systemctl --user' if scope == 'user' else 'systemctl' -%}
        {%- set sudo_cmd = '-' if scope == 'user' else 'sudo' -%}
        {%- set _ = rows.append('  "' ~ name ~ '|' ~ target ~ '|' ~ unit_dir ~ '|' ~ systemctl ~ '|' ~ sudo_cmd ~ '"') -%}
      {%- endfor -%}
      {{ rows | join('\n') }}
    _bin_item:
      name: install-dropin.sh
      helpers: false
      generated: "{{ lookup('template', 'files/systemd/install-dropin.sh') }}"

- name: 'Add systemd install-unit.sh script to BINS'
  set_fact:
    BINS: "{{ enhancedBins | merge_list(BINS, preset='bins_generated') }}"
  when: (_systemd_has_units or SYSTEMD_ROOTS is deflengthy) and SYSTEMD_INSTALL_BYPASS is deffalsy
  vars:
    enhancedBins:
      - name: install-unit.sh
        src: ../systemd/install-unit.sh
        compose: False
        bypass: false
        origin_subsystems: [systemd]
        bypass_scopes: [systemd]

- name: 'Compile systemd install specs'
  set_fact:
    _systemd_install_specs: >-
      {{ _systemd_install_specs_rendered }}
  vars:
    # Unified install-spec list: one entry per (unit, scope) from BOTH top-level
    # units and SYSTEMD_ROOTS, already gated by SYSTEMD_<SCOPE>_<TYPE>_INSTALL.
    # Each spec: {name, type, scope, enable, start, strategy, instanced, instances}.
    # enable/start resolve root -> top-level -> default(true).
    _systemd_install_specs_rendered: >-
      {%- set specs = [] -%}
      {# top-level units (SYSTEMD_SERVICE/SYSTEMD_SOCKET/...) #}
      {%- for t in (SYSTEMD_UNITTYPES | normalize(to='list')) -%}
        {%- set nm_raw = lookup('vars', 'SYSTEMD_' ~ t | upper, default='') -%}
        {%- set nm = nm_raw if (nm_raw and nm_raw not in [True, 'True']) else NAME -%}
        {%- set inst = SYSTEMD_INSTANCES | default(False) -%}
        {%- set strategy = SYSTEMD_INSTALL_STRATEGY | def('link', enum=['link', 'copy']) -%}
        {%- set _ = specs.append({'name': nm, 'type': t, 'enable': (SYSTEMD_ENABLE | default(True)) | bool, 'start': (SYSTEMD_START | default(True)) | bool, 'strategy': strategy, 'instanced': inst | bool, 'instances': (inst if (inst is sequence and inst is not string and inst is not boolean) else [])}) -%}
      {%- endfor -%}
      {# SYSTEMD_ROOTS units #}
      {%- for root_name in (SYSTEMD_ROOTS | normalize(to='list')) -%}
        {%- set rd = lookup('vars', root_name, default={}) -%}
        {%- for t in SYSTEMD_TYPE_CONFIG.keys() -%}
          {%- set tc = SYSTEMD_TYPE_CONFIG[t] -%}
          {%- set vk = 'SYSTEMD_' ~ tc.var_suffix -%}
          {%- if rd[vk] is defined or rd['SYSTEMD_' ~ (t | upper)] is defined -%}
            {%- set nm_raw = rd['SYSTEMD_' ~ (t | upper)] | default('') -%}
            {%- set nm = nm_raw if (nm_raw and nm_raw not in [True, 'True']) else NAME -%}
        {%- set inst = rd.SYSTEMD_INSTANCES | def(SYSTEMD_INSTANCES, False) -%}
        {%- set root_legacy_copy = rd.SYSTEMD_INSTALL_COPY | def(rd.SYSTEMD_COPY, False) -%}
        {%- set root_strategy_default = 'copy' if root_legacy_copy | bool else SYSTEMD_INSTALL_STRATEGY -%}
        {%- set strategy = rd.SYSTEMD_INSTALL_STRATEGY | def(root_strategy_default, 'link', enum=['link', 'copy']) -%}
        {%- set _ = specs.append({'name': nm, 'type': t, 'enable': (rd.SYSTEMD_ENABLE | def(SYSTEMD_ENABLE, True)) | bool, 'start': (rd.SYSTEMD_START | def(SYSTEMD_START, True)) | bool, 'strategy': strategy, 'instanced': inst | bool, 'instances': (inst if (inst is sequence and inst is not string and inst is not boolean) else [])}) -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
      {# expand each unit x [system,user], gated by per-scope-type install flags #}
      {%- set out = [] -%}
      {%- for s in specs -%}
        {%- for scope in ['system', 'user'] -%}
          {# Types without a legacy per-scope gate still obey SYSTEMD_INSTALL. #}
          {%- if lookup('vars', 'SYSTEMD_' ~ (scope | upper) ~ '_' ~ (s.type | upper) ~ '_INSTALL', default=(SYSTEMD_INSTALL_VALID in [scope, 'both', 'separate', true])) -%}
            {%- set _ = out.append(s | combine({'scope': scope})) -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
      {{ out }}

- name: 'Reject user-scope units with system-only directory maps'
  fail:
    msg: >-
      SYSTEMD user-scope install for {{ item.name }}.{{ item.type }} is invalid:
      directory map '{{ _dir_map }}' publishes outside the user manager unit directory.
  when:
    - item.scope == 'user'
    - _dir_map != 'system'
  loop: "{{ _systemd_install_specs }}"
  vars:
    _dir_map: "{{ SYSTEMD_TYPE_CONFIG[item.type].dir_map | default('system') }}"

- name: 'Generate systemd install scripts'
  set_fact:
    # Resolve loop-local item/scope references before annotate_bins copies the
    # record; otherwise Ansible can retain them and fail in a later merge after
    # this loop's `item` has left scope.
    BINS: "{{ BINS | merge_list(([_bin_item] | resolve) | annotate_bins('systemd'), preset='bins_generated') }}"
  when:
    - SYSTEMD_INSTALL_BYPASS is deffalsy
  loop: "{{ _systemd_install_specs }}"
  vars:
    _is_user: "{{ item.scope == 'user' }}"
    # SYSTEMD_INSTALL_VALID: enum-validated (see vars/systemd.yaml); a typo
    # would silently render single-mode instead of separate dual files.
    _is_separate_mode: "{{ SYSTEMD_INSTALL_VALID == 'separate' }}"
    _type_config: "{{ SYSTEMD_TYPE_CONFIG[item.type] }}"
    _dir_map: "{{ _type_config.dir_map | default('system') }}"
    _unit_dir: >-
      {%- if _dir_map == 'network' -%}/etc/systemd/network
      {%- elif _dir_map == 'nspawn' -%}/etc/systemd/nspawn
      {%- elif _is_user -%}${HOME}/.config/systemd/user
      {%- else -%}/etc/systemd/system{%- endif -%}
    _unit_name: "{{ item.name }}"
    # The unit FILE basename gets -user only in separate mode (distinct files).
    _user_suffix: "{{ '-user' if _is_separate_mode and _is_user else '' }}"
    _unit_template: "{{ _unit_name }}{{ _user_suffix }}{{ '@' if item.instanced else '' }}"
    # enable=false -> empty targets -> install-unit.sh links only (no enable).
    # start=false -> pass --skip-start -> enable without --now.
    _enable_targets: >-
      {%- if not item.enable -%}
      {%- elif item.instanced -%}
        {%- if item.instances | length > 0 -%}
          {%- for inst in item.instances -%}{{ item.name }}{{ _user_suffix }}@{{ inst }}{% if not loop.last %} {% endif %}{%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {{ item.name }}{{ _user_suffix }}
      {%- endif -%}
    _generated: |
      UNIT_TEMPLATE="{{ _unit_template }}"
      UNIT_ENABLE_TARGETS="{{ _enable_targets }}"
      UNIT_TYPE={{ item.type }}
      UNIT_DIR="{{ _unit_dir }}"
      # Matches this unit's LINKS record id; ${HOME} stays literal for user
      # scope (single quotes), where it is a runtime root.
      UNIT_LINK_ID='{{ item.scope }}:{{ _unit_dir }}/{{ _unit_template }}.{{ item.type }}'
      UNIT_LINK_DEFAULT={{ item.strategy }}
      SYSTEMCTL="{{ 'systemctl --user' if _is_user else 'systemctl' }}"
      SUDO_CMD="{{ '' if _is_user else 'sudo' }}"
      source "$(dirname "$0")/install-unit.sh"{{ ' --skip-start' if not item.start else '' }}
    # Filename: install-<type>[-<unitname>][-user].sh
    #   -<unitname> included iff unitname != NAME (keeps the common case stable)
    #   -user included for user scope (matches legacy convention)
    _bin_item:
      name: "install-{{ item.type }}{{ '-' ~ item.name if item.name != NAME else '' }}{{ '-user' if _is_user else '' }}.sh"
      bypass: "{{ ['LINK', 'SYSTEMD', 'USER_SYSTEMD'] if _is_user else ['LINK', 'SYSTEMD'] }}"
      # units lane: enable/start must follow artifact installs (a unit whose
      # ExecStart binary has not landed would crashloop on fresh installs)
      # and identity creation (sysusers), via the bin_composers lane sort.
      phase: units
      generatedAt: end
      generated: "{{ _generated }}"
      scope: "{{ ['user'] if _is_user else [] }}"
      # Group these installers under the stable systemd subsystem compositor
      # (install-systemd[-user].sh), including single-leaf configurations.
      subsystem: systemd

- name: 'Contribute systemd unit link records'
  set_fact:
    # Each installable unit gets a LINKS record so links.mjs owns the unit-dir
    # symlink: status reports drift (a package overwriting our unit), audit
    # cross-checks deployments claiming the same unit path, remove uninstalls.
    # install-unit.sh applies the record (UNIT_LINK_ID) before enable; the
    # records lane afterwards sees it managed. Policy replace matches the old
    # ln -sf (a foreign squatter is replaced, not preserved). ${HOME} stays
    # literal for user scope -- a runtime root links.mjs expands.
    LINKS: "{{ (LINKS | default([])) | merge_list(_systemd_unit_link_records | attribute_links(NAME, 'systemd'), preset='append', resolve=True) }}"
  when: SYSTEMD_INSTALL_BYPASS is deffalsy
  vars:
    _systemd_unit_link_records: >-
      {%- set records = [] -%}
      {%- for s in _systemd_install_specs -%}
        {%- set tc = SYSTEMD_TYPE_CONFIG[s.type] -%}
        {%- set dir_map = tc.dir_map | default('system') -%}
        {%- set udir = '/etc/systemd/network' if dir_map == 'network' else (
                       '/etc/systemd/nspawn' if dir_map == 'nspawn' else (
                       '${HOME}/.config/systemd/user' if s.scope == 'user' else '/etc/systemd/system')) -%}
        {%- set suffix = '-user' if (SYSTEMD_INSTALL_VALID == 'separate' and s.scope == 'user') else '' -%}
        {%- set tpl = s.name ~ suffix ~ ('@' if s.instanced else '') -%}
        {%- set _ = records.append({
                'src': ETC ~ '/' ~ tpl ~ '.' ~ s.type,
                'dest': udir ~ '/' ~ tpl ~ '.' ~ s.type,
                'scope': s.scope,
                'policy': 'replace',
                'strategies': {'available': ['link', 'copy'], 'default': s.strategy},
                'compose': false,
              }) -%}
      {%- endfor -%}
      {{ records }}
