---
# gen_status.tasks -- assemble the STATUSES reporter list and merge the status
# subsystem's contrib (the status.sh orchestrator + the status-dirs.sh builtin +
# ENV that propagates STATUS_DIRS / STATUS_DIRS_SUDO colon-joined to bins).
#
# Runs after gen_kernel, which appends the kernel reporters (status-sysctl.ts /
# status-modules.ts / status-sysfs.ts) to STATUSES for active leaves. This file
# appends status-dirs.sh when STATUS_DIRS / STATUS_DIRS_SUDO are declared, then
# merges contrib only when the status subsystem is active. status.sh bakes the
# final STATUSES list in at render time.

- name: "Compfuzor: register status-dirs reporter"
  set_fact:
    STATUSES: "{{ STATUSES | merge_list(['status-dirs.sh'] if (STATUS_DIRS is deftruthy or STATUS_DIRS_SUDO is deftruthy) else [], preset='append') }}"

- name: "Compfuzor: synthesize status artifacts"
  set_fact:
    BINS: "{{ lookup('merge_subsys', id='status', contrib='BINS') }}"
    ENV: "{{ lookup('merge_subsys', id='status', contrib='ENV') }}"
  when: lookup('subsys', id='status', get='active', default=false) | bool
