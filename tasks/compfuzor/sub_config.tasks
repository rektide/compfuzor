---
- name: "Compfuzor: compile config declarations"
  set_fact:
    SUBSYSTEM: "{{ SUBSYSTEM | config_publish(compiled) }}"
  vars:
    base_compiled: >-
      {{ CONFIGS | default({}) | resolve |
         config_compile(ETC, BINS_DIR, CONFIG_DISABLED_SUFFIX) }}
    compiled: >-
      {{ base_compiled |
         config_context_compile(
           ({} if (CONFIG_CONTEXTS_BYPASS | default(False) | bool) else (CONFIG_CONTEXTS | default({}) | resolve)),
           ETC,
           BINS_DIR) }}
  when: CONFIGS is defined
