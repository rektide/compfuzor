---
- name: "Compfuzor: compile drop-in and config declarations"
  set_fact:
    SUBSYSTEM: "{{ SUBSYSTEM | config_publish(compiled) }}"
  vars:
    compiled: >-
      {{ DROPINS | default({}) | resolve |
         config_compile(CONFIGS | default({}) | resolve, BINS_DIR) }}
  when: DROPINS is defined or CONFIGS is defined
