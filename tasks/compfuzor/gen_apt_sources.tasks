---
# APT/APTS selects deb822 by presence, even if empty (invalid input fails).
# Source generation is independent of PKGS, APT_BYPASS and APTLANE_BYPASS.
- include_defaults:
    file: vars/apt.yaml
- name: "Compfuzor: generate deb822 apt source payload"
  set_fact:
    # Rendered artifacts for the filesystem pass and later publication.
    ETC_FILES: "{{ (ETC_FILES | default([])) + _apt_files }}"
    BINS: "{{ BINS | default([]) | merge_list(_apt_bin, preset='bins_generated', resolve=True) }}"
    # Delivery metadata is shared by render-time and install-time actions.
    _apt_source_name: "{{ _source_name }}"
    _apt_key_name: "{{ _key_name }}"
    _apt_key_ext: "{{ _key_ext }}"
    _apt_key_url: "{{ _key_url }}"
    _apt_key_vendor: "{{ _key_vendor }}"
    _apt_pref_text: "{{ _prefs }}"
  vars:
    # Naming / key acquisition: URL wins over vendored bytes when both exist.
    _source_name: "{{ APT_SOURCELIST | default(NAME) }}"
    _key_name: "{{ APT_TRUSTED | default(TYPE) }}"
    _key_ext: "{{ APT_GPG_EXT | default('gpg') }}"
    _key_url: "{{ APT_KEYRING_URL | default('') }}"
    _key_vendor: "{{ lookup('fileglob', 'files/apt-repos/' ~ _key_name ~ '.' ~ _key_ext, wantlist=True) | first | default('') }}"
    # APT, then APTS; neither shares input with APT_REPO or APT_LIST_URL.
    _stanzas: "{{ ([APT] if APT is defined else []) + (APTS | default([])) }}"
    _signed_by: "{{ (APT_KEYRINGS_DIR | default('/usr/share/keyrings')) ~ '/' ~ _key_name ~ '.' ~ _key_ext if _key_url or _key_vendor else none }}"
    _source: "{{ _stanzas | apt_sources(APT_DEFAULTS, _signed_by) }}"
    _prefs: "{{ APT_PREFS | apt_preferences if APT_PREFS is defined else '' }}"
    _apt_files: >-
      {{ [{'name': _source_name ~ '.sources', 'content': _source, 'mode': '0644'}]
         + ([{'name': _source_name ~ '.pref', 'content': _prefs, 'mode': '0644'}] if _prefs else [])
         + ([{'name': _key_name ~ '.' ~ _key_ext, 'src': _key_vendor, 'mode': '0644'}]
            if _key_vendor and not _key_url else []) }}
    _install_script: "{{ lookup('template', 'files/_apt_install_sources') }}"
    _apt_bin:
      name: install-apt-sources.sh
      phase: packages
      generated: "{{ _install_script }}"
      bypass: false
- name: "Compfuzor: validate deb822 output names"
  assert:
    that:
      - _apt_source_name is match('^[A-Za-z0-9][A-Za-z0-9._-]*$')
      - _apt_key_name is match('^[A-Za-z0-9][A-Za-z0-9._-]*$')
      - _apt_key_ext in ['gpg', 'asc']
      - not (APT_DEARMOR | default(false) | bool) or _apt_key_ext == 'gpg'
- name: "Compfuzor: warn when new apt sources override legacy settings"
  debug:
    msg: "APT/APTS uses deb822; ignoring legacy source/pin vars: {{ _apt_ignored | join(', ') }}"
  when: _apt_ignored | length > 0
  vars:
    _apt_ignored: >-
      {{ ['APT_REPO', 'APT_REPOS', 'APT_LIST_URL', 'APT_DISTRIBUTION', 'APT_DISTRIBUTIONS',
          'APT_COMPONENT', 'APT_COMPONENTS', 'APT_ARCHS', 'APT_SOURCE', 'APT_TRUST',
          'APT_KEY', 'APT_PIN', 'APT_PIN_PRIORITY', 'APT_PIN_PACKAGE']
          | select('in', lookup('varnames', '^APT_.*$', wantlist=True)) | list }}
