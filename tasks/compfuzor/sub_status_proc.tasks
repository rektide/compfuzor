---
# Compile the broad STATUS_PROC provider collection into one subsystem record.

- name: "Compfuzor: publish STATUS_PROC provider"
  set_fact:
    SUBSYSTEM: >-
      {{
        SUBSYSTEM
        | subsystem_publish(
            'status_proc',
            {
              'subsystem': 'status_proc',
              'domain': 'status',
              'status': 'active',
              'requested': true,
              'bypassed': false,
              'valid': true,
              'active': true,
              'reasons': [],
              'spec': _status_proc_compiled.spec,
              'contrib': _status_proc_compiled.contrib,
            }
          )
      }}
  when: _status_proc_compiled.spec | length > 0
  vars:
    # STATUS_PROC rows carry templated values (unit names, expected
    # executables). status_proc_compile validates through
    # raw_copy_template_data, which sees unrendered strings, so resolve the
    # declarations at this scope first -- the same lazy-template contract as
    # gen_zim's projections (.design/zim-generator/init0.gpt56.md).
    _status_proc_input: >-
      {{
        []
        if (STATUS_PROC_BYPASS is deftruthy or STATUS_BYPASS is deftruthy)
        else STATUS_PROC | resolve
      }}
    _status_proc_compiled: >-
      {{
        _status_proc_input
        | status_proc_compile(
            _STATUS_PROC_KINDS,
            SYSTEMD_SCOPE | default('system')
          )
      }}
