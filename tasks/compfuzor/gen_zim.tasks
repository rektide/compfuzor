---
# gen_zim.tasks -- zim host/contributor synthesis (MCP-style).
#
# Contributor branch: a playbook declaring ZIM_MODULE / ZIM_MODULES renders one
# fragment file per module under zim/ (or zim-disabled/ for enabled:false)
# via the zim_fragment filter. Fragment names are relative to the ETC dir. The
# host bridge delegates each durable source to config-remote.ts.
# Filenames
# carry a phase number so sorted glob order across independent contributors
# yields deterministic load order at assembly time.
#
# A module whose source is a local .zsh file (or `file: true`) is rendered as a
# LOCAL zimfw module: the source script becomes zim-modules/<name>/init.zsh and
# the declaration's `zmodule` points at that absolute path (zimfw loads it as an
# already-installed module). This is how compfuzor ships in-repo zsh scripts as
# zimfw-loadable modules without a separate git repo.
#
# Every contributor also gets an auto-generated install-user-zimfw.sh (user
# scope -- the `install-user-` prefix is what gen_bins keys on) that promotes
# its zim/ fragments into the zim host assembly dir, so a contributor only
# declares ZIM_MODULES and otherwise does nothing install-shaped itself.
#
# ZIM_ARRAYS declares Zsh-only arrays directly rather than projecting process
# ENV. `path` is supported and remains tied to exported `PATH` by Zsh:
#
#   ZIM_ARRAYS:
#     fpath: ["${HOME}/.local/share/zsh/functions", /usr/share/zsh/site-functions]
#     path: ["${HOME}/.local/bin", /usr/local/bin, /usr/bin]
#
# Existing non-empty arrays win. Because `path` normally starts populated, set
# COMPFUZOR_ENV_OVERWRITE=PATH (or a matching pattern) to replace it explicitly.
#
# Host branch: a playbook marked ZIM_HOST provides the install-zim.sh bridge.
# The host's CONFIGS declaration owns the remote target and lifecycle tooling.

- name: "Compfuzor: render zim contributor fragments"
  set_fact:
    ETC_FILES: "{{ ETC_FILES | merge_list(_zim_fragments, preset='append') }}"
    ETC_DIRS: "{{ ETC_DIRS | merge_list(['zim', 'zim-disabled'], _zim_module_dirs, preset='append') }}"
  when:
    - (ZIM_MODULE is defined or ZIM_MODULES is defined or ZIM_ENV is deflengthy or ZIM_ARRAYS is deflengthy)
    - ZIM_BYPASS is deffalsy
  vars:
    # ZIM_ENV: promote selected ENV vars into an auto-generated env module.
    # Projection source is the same effective mapping fs_env.tasks renders
    # into env.export -- (ENV_LIST-resolved union ENV) overridden by
    # (ENV_PRIO_LIST-resolved union ENV_PRIO) -- filtered to the named keys.
    # Selective by design: the generic ENV floor (DIR/NAME/TYPE/...) stays
    # env.export-only; only explicitly named keys reach shells. `resolve`
    # renders value template strings at THIS task's scope, dodging the
    # lazy-template trap documented in .design/zim-generator/init0.gpt56.md.
    _zim_env_keys: "{{ ZIM_ENV|normalize(to='list')|map('upper')|list }}"
    _zim_env_list_names: "{{ (ENV_LIST|default([]))|normalize(to='list') }}"
    _zim_env_prio_list_names: "{{ (ENV_PRIO_LIST|default([]))|normalize(to='list') }}"
    _zim_env_lookup: "{{ lookup('vars_dict', _zim_env_list_names|map('upper')|list, default=_zim_env_missing) if _zim_env_list_names|length > 0 else {} }}"
    _zim_env_prio_lookup: "{{ lookup('vars_dict', _zim_env_prio_list_names|map('upper')|list, default=_zim_env_missing) if _zim_env_prio_list_names|length > 0 else {} }}"
    _zim_env_missing: "__MISSING_COMPFUZOR__"
    _zim_env_effective: >-
      {{ _zim_env_lookup
         | combine(ENV if ENV is mapping else {})
         | combine(_zim_env_prio_lookup)
         | combine(ENV_PRIO if ENV_PRIO is defined and ENV_PRIO is mapping else {}) }}
    _zim_env_projection: >-
      {{ _zim_env_effective | dict2items
         | selectattr('key', 'in', _zim_env_keys)
         | items2dict
         | resolve }}
    _zim_env_module:
      name: "{{ ZIM_ENV_NAME|default(NAME ~ '-env') }}"
      phase: "{{ ZIM_ENV_PHASE|default('tools') }}"
      env: "{{ _zim_env_projection }}"
      comment: "{{ 'promoted from ENV via ZIM_ENV: ' ~ _zim_env_keys|join(',') }}"
    # ZIM_ARRAYS is Zsh-only and direct: unlike ZIM_ENV it does not project
    # from process ENV, because arbitrary arrays cannot be exported.
    _zim_array_module:
      name: "{{ ZIM_ARRAYS_NAME|default(NAME ~ '-arrays') }}"
      phase: "{{ ZIM_ARRAYS_PHASE|default('tools') }}"
      arrays: "{{ ZIM_ARRAYS | default({}) | resolve }}"
      comment: "{{ 'Zsh arrays from ZIM_ARRAYS: ' ~ (ZIM_ARRAYS.keys()|list|join(',')) if ZIM_ARRAYS is mapping else 'Zsh arrays from ZIM_ARRAYS' }}"
    _zim_modules: >-
      {{ ZIM_MODULE|normalize(to='list')
         + ZIM_MODULES|normalize(to='list')
         + ([_zim_env_module] if ZIM_ENV is deflengthy else [])
         + ([_zim_array_module] if ZIM_ARRAYS is deflengthy else []) }}
    _zim_phase: "{{ ZIM_PHASE|def }}"
    _zim_fragments: "{{ _zim_modules | zim_fragment(phase=_zim_phase, etc=ETC) }}"
    # local modules (file, env, or arrays) emit a zim-modules/<name>/init.zsh record;
    # create each <name> dir so the ETC_FILES writer can land it.
    _zim_module_dirs: >-
      {{ _zim_fragments
        | map(attribute='name')
        | select('match', '^zim-modules/')
        | map('regex_replace', '/init\.zsh$', '')
        | list }}

- name: "Compfuzor: ZIM_ENV keys must exist in the effective env"
  fail:
    msg: >-
      ZIM_ENV names keys absent from the effective ENV mapping (ENV/ENV_LIST
      overridden by ENV_PRIO/ENV_PRIO_LIST): {{ _zim_env_missing_keys | join(', ') }}.
      Fix the ZIM_ENV list or define the vars.
  when:
    - ZIM_ENV is deflengthy
    - ZIM_BYPASS is deffalsy
    - _zim_env_missing_keys|length > 0
  vars:
    _zim_env_keys: "{{ ZIM_ENV|normalize(to='list')|map('upper')|list }}"
    _zim_env_missing_keys: "{{ _zim_env_keys | difference(_zim_env_effective.keys()|list) }}"
    _zim_env_list_names: "{{ (ENV_LIST|default([]))|normalize(to='list') }}"
    _zim_env_prio_list_names: "{{ (ENV_PRIO_LIST|default([]))|normalize(to='list') }}"
    _zim_env_missing: "__MISSING_COMPFUZOR__"
    _zim_env_lookup: "{{ lookup('vars_dict', _zim_env_list_names|map('upper')|list, default=_zim_env_missing) if _zim_env_list_names|length > 0 else {} }}"
    _zim_env_prio_lookup: "{{ lookup('vars_dict', _zim_env_prio_list_names|map('upper')|list, default=_zim_env_missing) if _zim_env_prio_list_names|length > 0 else {} }}"
    _zim_env_effective: >-
      {{ _zim_env_lookup
         | combine(ENV if ENV is mapping else {})
         | combine(_zim_env_prio_lookup)
         | combine(ENV_PRIO if ENV_PRIO is defined and ENV_PRIO is mapping else {}) }}

- name: "Compfuzor: generate contributor install-user-zimfw.sh"
  set_fact:
    BINS: "{{ BINS | merge_list(_zimfw_install_bin | annotate_bins('zim'), preset='bins_generated') }}"
  when:
    - (ZIM_MODULE is defined or ZIM_MODULES is defined or ZIM_ENV is deflengthy or ZIM_ARRAYS is deflengthy)
    - ZIM_HOST is not defined
    - ZIM_BYPASS is deffalsy
  vars:
    _zimfw_install_bin:
      name: install-user-zimfw.sh
      scope: [user]
      basedir: False
      bypass: ZIM
      content: |
        # Host discovery: ZIM_HOST_DIR wins; otherwise resolve through the zim
        # config link (~/.config/zsh/zimfw.conf -> <host>/[etc/]zimfw.conf),
        # which every zim host install creates -- the link IS the registry.
        # Final fallback /opt/zim-main (OPTS_DIR default location).
        host="${ZIM_HOST_DIR:-}"
        if [ -z "$host" ]; then
          _conf="${ZIM_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/zsh/zimfw.conf}"
          _real=$(readlink -f "$_conf" 2>/dev/null || true)
          if [ -n "$_real" ]; then
            _etc_dir="${_real%/zimfw.conf}"
            for _cand in "${_real%/etc/zimfw.conf}" "$_etc_dir" "/opt/$(basename "$_etc_dir")"; do
              if [ "$_cand" != "$_real" ] && [ -x "$_cand/bin/install-zim.sh" ]; then
                host="$_cand"
                break
              fi
            done
          fi
        fi
        host="${host:-/opt/zim-main}"
        if [ -x "$host/bin/install-zim.sh" ]; then
          "$host/bin/install-zim.sh" "{{DIR}}"
        else
          _cf_report_skip "install-user-zimfw.sh" "zim: host not found at $host (set ZIM_HOST_DIR)"
        fi

- name: "Compfuzor: synthesize zim host artifacts"
  set_fact:
    BINS: "{{ BINS | merge_list(_zim_host_bins | annotate_bins('zim'), preset='bins_generated') }}"
  when:
    - ZIM_HOST is defined
    - ZIM_BYPASS is deffalsy
  vars:
    _zim_host_bins:
      - name: install-zim.sh
        src: ../install-zim.sh
        basedir: False
