- name: "Compfuzor: set repos variables"
  set_fact: "{{var_name}}={{REPO_DIR}}/{{item}}"
  with_items: "{{(REPOS|default({})).keys()}}"
  when: "REPOS is defined and not lookup('deftruthy', var_name)"
  vars:
    var_name: "{{item|upper|replace('-', '_')}}_DIR"
- name: "Compfuzor: clear generated tool-version links before repo update"
  shell: |
    set -eu
    generated_dir={{ (DIR + '/etc')|quote }}
    for name in .tool-versions mise.toml; do
      [ -L "$name" ] || continue
      [ "$(readlink -- "$name")" = "$generated_dir/$name" ] || continue
      [ -n "$(git status --porcelain=v1 --untracked-files=all -- "$name")" ] || continue
      if git cat-file -e "HEAD:$name" 2>/dev/null; then
        git restore --source=HEAD --staged --worktree -- "$name"
      else
        git reset --quiet -- "$name"
        rm -- "$name"
      fi
      printf 'changed:%s\n' "$name"
    done
  args:
    chdir: "{{ REPO_DIR }}"
  register: _tool_version_repo_cleanup
  changed_when: "'changed:' in _tool_version_repo_cleanup.stdout"
  when:
    - REPO_DIR is directory
    - (REPO_DIR + '/.git') is exists
    - (REPO_DIR + '/.tool-versions') is link or (REPO_DIR + '/mise.toml') is link
    - GIT_UPDATE|default(true)|bool
    - GIT_BYPASS is deffalsy
    - REPO_BYPASS is deffalsy
- name: "Add GOPATH and REPO_DIR to ENV"
  set_fact:
    ENV: "{{ env_current | combine(env_additions) }}"
  vars:
    env_current: "{{ ENV if ENV is defmapping else {} }}"
    gopath_env: "{{ {'GOPATH': DIR} if REPO_GOGET is defined and 'GOPATH' not in env_current else {} }}"
    env_additions: "{{ gopath_env | combine_iff({'REPO_DIR': REPO_DIR}) }}"
