---
- name: "Compfuzor: compile explicit application ENV configuration"
  set_fact:
    _ENV_CONFIG: "{{ _compiled }}"
    CONFIG_DEFINITIONS: "{{ CONFIG_DEFINITIONS | default({}) | env_config_add(_compiled) }}"
    ETC_FILES: "{{ ETC_FILES | merge_list(_compiled.files, preset='append') }}"
    ETC_DIRS: "{{ ETC_DIRS | merge_list(_compiled.dirs, preset='append_unique') }}"
    FILES: "{{ FILES | merge_list([_compiled.context_file], preset='append') }}"
  vars:
    _compiled: >-
      {{ ENV_CONFIG | resolve | env_config_compile(
          ENV | default({}) | resolve, ENV_LIST | default([]),
          ENV_PRIO | default({}) | resolve, ENV_PRIO_LIST | default([]),
          _env_variables | resolve, ENV_CONTRIBUTIONS | default({}) | resolve, ETC, DIR) }}
    _env_names: "{{ ENV | default({}) | env_config_names(ENV_PRIO | default({}), ENV_CONTRIBUTIONS | default({}), ENV_LIST | default([]), ENV_PRIO_LIST | default([])) }}"
    _env_variables: "{{ lookup('vars_dict', _env_names + (_env_names | map('upper') | list), default='__ENV_CONFIG_UNSET_COMPFUZOR__') }}"
  when: ENV_CONFIG is defined and ENV_CONFIG != False and not (ENV_BYPASS | default(False) | bool)
