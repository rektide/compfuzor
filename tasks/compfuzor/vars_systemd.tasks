---
# See skill/systemd.md for systemd unit generation documentation (and keep up to date when making changes to compfuzor systemd)
- name: "msg='Compfuzor: sourcing systemd variables'"
  #  binfmtdir
  #  catalogdir
  #  modulesloaddir
  #  pcfiledir
  #  prefix
  #  sysctldir
  #  systemdshutdowndir
  #  systemdsleepdir
  #  systemdsystemconfdir
  #  systemdsystemgeneratordir
  #  systemdsystempresetdir
  #  systemdsystemunitdir
  #  systemdsystemunitpath
  #  systemduserconfdir
  #  systemdusergeneratordir
  #  systemduserpresetdir
  #  systemduserunitdir
  #  systemduserunitpath
  #  systemdutildir
  #  systemgidmax
  #  systemuidmax
  #  sysusersdir
  #  tmpfilesdir
  shell: |
    systemd_var() {
      value=$(pkg-config systemd --variable="$1" 2>/dev/null || true)
      printf '%s\n' "${value:-$2}"
    }
    systemd_var binfmtdir /usr/lib/binfmt.d
    systemd_var catalogdir /usr/lib/systemd/catalog
    systemd_var modulesloaddir /usr/lib/modules-load.d
    systemd_var pcfiledir /usr/share/pkgconfig
    systemd_var prefix /usr
    systemd_var sysctldir /usr/lib/sysctl.d
    systemd_var systemdshutdowndir /usr/lib/systemd/system-shutdown
    systemd_var systemdsleepdir /usr/lib/systemd/system-sleep
    systemd_var systemdsystemconfdir /etc/systemd/system
    systemd_var systemdsystemgeneratordir /usr/lib/systemd/system-generators
    systemd_var systemdsystempresetdir /usr/lib/systemd/system-preset
    systemd_var systemdsystemunitdir /usr/lib/systemd/system
    systemd_var systemdsystemunitpath /etc/systemd/system:/run/systemd/system:/usr/local/lib/systemd/system:/usr/lib/systemd/system
    systemd_var systemduserconfdir /etc/systemd/user
    systemd_var systemdusergeneratordir /usr/lib/systemd/user-generators
    systemd_var systemduserpresetdir /usr/lib/systemd/user-preset
    systemd_var systemduserunitdir /usr/lib/systemd/user
    systemd_var systemduserunitpath /etc/systemd/user:/run/systemd/user:/usr/local/lib/systemd/user:/usr/local/share/systemd/user:/usr/lib/systemd/user:/usr/share/systemd/user
    systemd_var systemdutildir /usr/lib/systemd
    systemd_var systemgidmax 999
    systemd_var systemuidmax 999
    systemd_var sysusersdir /usr/lib/sysusers.d
    systemd_var tmpfilesdir /usr/lib/tmpfiles.d
  changed_when: False
  check_mode: false
  register: _systemd_vars
- name: "Defaulting unset systemd variables"
  action: include_defaults
  args:
    file: "vars/systemd.yaml"
