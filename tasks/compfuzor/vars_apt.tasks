- name: "Compfuzor: source apt variables"
  set_fact:
  vars:
    # Deb822 instances get distinct filenames; legacy .list keeps TYPE.
    _sourcelist: "{{ APT_SOURCELIST | def(NAME if APT is defined or APTS is defined else TYPE) }}"
    _trusted: "{{APT_TRUSTED|def(TYPE, NAME)}}"
    _arch: "{{APT_ARCH|default(ARCH)}}"
    _name: "{{TYPE}}"
    _gpg: "{{APT_GPG_EXT|default('gpg')}}"
    _armor: "{{'.armor' if APT_DEARMOR is deftruthy else ''}}"
  args:
    APT_SOURCELIST: "{{_sourcelist}}"
    APT_TRUSTED: "{{_trusted}}"
    APT_ARCH: "{{_arch}}"
    APT_INSTALLS:
      - name: "{{_sourcelist}}"
        ext: list
        dir: /etc/apt/sources.list.d
        template: _apt.list
        conditional: "{{APT_REPO|truthy or APT_REPOS|truthy}}"
      # alt to above, source.list via url
      - name: "{{_sourcelist}}"
        ext: list
        dir: /etc/apt/sources.list.d
        url: "{{APT_LIST_URL|default('')}}"
        conditional: "{{APT_LIST_URL|truthy}}"
      - name: "{{_name}}"
        dir: /etc/apt/preferences.d
        ext: "pref"
        template: _apt-pin
        conditional: "{{APT_PIN_PRIORITY|truthy}}"
      - name: "{{_trusted}}"
        ext: "gpg.params"
        template: "apt-repos/{{_trusted}}.gpg.params"
        # fileglob (not `is file`): bare-name `is file` resolved against the
        # playbook dir and never matched, so vendored keyrings silently never
        # deployed (waydroid/jellyfin rendered .list but no keyring). The
        # apt_legacy template task prepends "files/" to item.template itself.
        conditional: "{{ lookup('fileglob', 'files/apt-repos/' ~ _trusted ~ '.gpg.params', wantlist=True) | length > 0 }}"
      - name: "{{_trusted}}"
        ext: "{{_gpg}}{{_armor}}"
        dir: /usr/share/keyrings
        template: "apt-repos/{{_trusted}}.{{_gpg}}"
        conditional: "{{ lookup('fileglob', 'files/apt-repos/' ~ _trusted ~ '.' ~ _gpg, wantlist=True) | length > 0 }}"
      # alt to above, keyring via url
      - name: "{{_trusted}}"
        ext: "{{_gpg}}"
        dir: /usr/share/keyrings
        url: "{{APT_KEYRING_URL|def}}"
        conditional: "{{APT_KEYRING_URL|truthy}}"
- action: include_defaults
  args:
    file: "vars/pkgs.yaml"
