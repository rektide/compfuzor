---
- name: "Compfuzor: compile filesystem artifacts"
  set_fact:
    _ARTIFACTS: "{{ _artifact_context | compile_artifacts }}"
  vars:
    _artifact_context:
      DIR: "{{ DIR }}"
      NAME: "{{ NAME }}"
      DIRSET: "{{ DIRSET }}"
      FS_BYPASS: "{{ FS_BYPASS | default(False) }}"
      DIR_BYPASS: "{{ DIR_BYPASS | default(False) }}"
      FILES: "{{ lookup('vars', 'FILES', default=False) }}"
      OPT: "{{ lookup('vars', 'OPT', default=False) }}"
      OPT_BYPASS: "{{ OPT_BYPASS | default(False) }}"
      OPT_FILES: "{{ lookup('vars', 'OPT_FILES', default=False) }}"
      SRV: "{{ lookup('vars', 'SRV', default=False) }}"
      SRV_BYPASS: "{{ SRV_BYPASS | default(False) }}"
      SRV_FILES: "{{ lookup('vars', 'SRV_FILES', default=False) }}"
      ETC: "{{ lookup('vars', 'ETC', default=False) }}"
      ETC_BYPASS: "{{ ETC_BYPASS | default(False) }}"
      ETC_FILES: "{{ lookup('vars', 'ETC_FILES', default=False) }}"
      VAR: "{{ lookup('vars', 'VAR', default=False) }}"
      VAR_BYPASS: "{{ VAR_BYPASS | default(False) }}"
      VAR_FILES: "{{ lookup('vars', 'VAR_FILES', default=False) }}"
      LOG: "{{ lookup('vars', 'LOG', default=False) }}"
      LOG_BYPASS: "{{ LOG_BYPASS | default(False) }}"
      LOG_FILES: "{{ lookup('vars', 'LOG_FILES', default=False) }}"
      SPOOL: "{{ lookup('vars', 'SPOOL', default=False) }}"
      SPOOL_BYPASS: "{{ SPOOL_BYPASS | default(False) }}"
      SPOOL_FILES: "{{ lookup('vars', 'SPOOL_FILES', default=False) }}"
      CACHE: "{{ lookup('vars', 'CACHE', default=False) }}"
      CACHE_BYPASS: "{{ CACHE_BYPASS | default(False) }}"
      CACHE_FILES: "{{ lookup('vars', 'CACHE_FILES', default=False) }}"
      SRC: "{{ lookup('vars', 'SRC', default=False) }}"
      SRC_BYPASS: "{{ SRC_BYPASS | default(False) }}"
      SRC_FILES: "{{ lookup('vars', 'SRC_FILES', default=False) }}"
      PID: "{{ lookup('vars', 'PID', default=False) }}"
      PID_BYPASS: "{{ PID_BYPASS | default(False) }}"
      PID_FILES: "{{ lookup('vars', 'PID_FILES', default=False) }}"
      SHARE: "{{ lookup('vars', 'SHARE', default=False) }}"
      SHARE_BYPASS: "{{ SHARE_BYPASS | default(False) }}"
      SHARE_FILES: "{{ lookup('vars', 'SHARE_FILES', default=False) }}"
