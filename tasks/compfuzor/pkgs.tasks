---
# package install lane (`apt` module). Recommend bypass in most cases:
# `-e PKGS_BYPASS=True` skips install churn and speeds up runs; the
# aptlane bins converge the same package list at install time
# (`sudo bash bin/install.sh`, see gen_apt.tasks). Run this lane only
# when apt state should change now.
- name: "Compfuzor: gather list of packages"
  set_fact:
    # first iteration loads in PKGS, next add each PKGSET.
    # this could be turned into two passes for clarity but this ought be faster
    _pkgs: "{{ _pkgs|def(PKGS, []) + (_pkgset if item != '' else []) }}"
  loop: "{{ [''] + PKGSET|normalize(to='list') + PKGSETS|def([]) }}"
  vars:
    _pkgset: "{{ lookup('vars', item, default=[]) }}"
- name: install pkgs
  apt:
    state: "{{APT_INSTALL}}"
    pkg: "{{_pkgs}}"
  become: "{{ PKG_BECOME|default(True) }}"
  when: >
    (_pkgs is deflengthy or PKGS is truthy) and
    ansible_pkg_mgr|default('apt') == 'apt'
# Arch side: _arch_pkgs is gathered once by gen_arch.tasks (compile phase,
# single source -- see its header) and simply consumed here. Empty default
# covers playbooks that declare no ARCH_PKGS at all.
- name: install arch pkgs
  command: pacman -S --needed --noconfirm {{ _arch_pkgs|default([])|join(' ') }}
  become: "{{ PKG_BECOME|default(True) }}"
  when: >
    _arch_pkgs|default([])|length > 0 and
    ansible_pkg_mgr|default('') == 'pacman'
