---
# Sources/pins publication. `APT:` / `APTS:` replaces (never combines with)
# the legacy APT_REPO/APT_LIST_URL .list path. aptlane handles packages only.
- import_tasks: apt_deb822.tasks
  when: APT is defined or APTS is defined
- import_tasks: apt_legacy.tasks
  when: APT is not defined and APTS is not defined
